#!/usr/bin/env bash
# tr-pdf - OCR a scanned PDF, then translate the text into a .docx.
#
# Usage:  tr-pdf <input.pdf> <output.docx>
#
# Two-stage by design. The OCR text layer is written to work/ocr/ and is
# meant to be VERIFIED BY A HUMAN before the translation stage runs. A model
# fed corrupted OCR produces a fluent, confident, wrong translation.
#
#   tr-pdf --ocr-only in.pdf     # stage 1: OCR, then go read the text
#   tr-pdf in.pdf out.docx       # both stages

set -euo pipefail
BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# See tr-run: an explicit TR_PROJECTS lifts the mount requirement, matching
# trlib.PROJECTS_OVERRIDDEN.
PROJECTS_OVERRIDDEN=${TR_PROJECTS+y}
TR_PROJECTS="${TR_PROJECTS:-$HOME/translation-work/confidential-projects}"

# The OCR text layer is the whole document in plain text -- the single most
# sensitive artefact this pipeline produces. It belongs inside the container
# and nowhere else, so resolve the project the same way tr-run does and
# refuse rather than fall back to a default path.
if [[ -z "${TR_ROOT:-}" ]]; then
  [[ -n "${PROJECTS_OVERRIDDEN:-}" ]] || mountpoint -q "$TR_PROJECTS" 2>/dev/null || {
    echo "container NOT mounted: $TR_PROJECTS" >&2
    echo "The OCR text layer is full plaintext of the document; it must not" >&2
    echo "be written outside the encrypted container. Refusing." >&2
    echo "  check:  case-status" >&2
    echo "  open:   case-open" >&2
    exit 2; }
  ACTIVE="$(tr -d '[:space:]' < "$TR_PROJECTS/.active" 2>/dev/null)"
  [[ -n "$ACTIVE" ]] || { echo "no active project. run: tr-project <name>" >&2; exit 2; }
  TR_ROOT="$TR_PROJECTS/$ACTIVE"
fi
export TR_ROOT
OCRDIR="$TR_ROOT/work/ocr"
LANGS="${TR_OCR_LANGS:-slv+eng}"
mkdir -p "$OCRDIR"

ONLY=0; [[ "${1:-}" == "--ocr-only" ]] && { ONLY=1; shift; }
IN="$1"; OUT="${2:-}"
base="$(basename "${IN%.*}")"
pdf="$OCRDIR/$base.ocr.pdf"
txt="$OCRDIR/$base.txt"

if [[ ! -f "$pdf" ]]; then
  echo "  OCR ($LANGS): $(basename "$IN")"
  ocrmypdf -l "$LANGS" --rotate-pages --deskew --clean \
           --output-type pdfa --quiet "$IN" "$pdf"
else
  echo "  OCR cached: $(basename "$pdf")"
fi
pdftotext -layout "$pdf" "$txt"

wc_w=$(wc -w < "$txt")
echo "  text layer: $txt  ($wc_w words)"

if [[ $ONLY -eq 1 ]]; then
  echo
  echo "  VERIFY THIS TEXT AGAINST THE PAGE IMAGES BEFORE TRANSLATING."
  echo "  Pay particular attention to: names, dates, case numbers, amounts,"
  echo "  and the characters c/s/z with carons."
  echo
  # --ocr-only is normally given just the input, so $OUT is empty and the
  # hint used to read: tr-pdf 'in.pdf' ''. Suggest the deliverable name the
  # second stage would actually produce.
  echo "  then:  tr-pdf '$IN' '${OUT:-$TR_ROOT/translated/$base.docx}'"
  exit 0
fi

[[ -n "$OUT" ]] || { echo "output path required" >&2; exit 1; }
"$BIN/tr-txt" "$txt" "$OUT"
