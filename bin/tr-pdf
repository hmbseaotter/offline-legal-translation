#!/usr/bin/env bash
# tr-pdf - OCR a scanned PDF, then translate the text into a .docx.
#
# Usage:  tr-pdf [--ocr-only] <input.pdf> [output.docx]
#
# Two-stage by design. The OCR text layer is written to work/ocr/ and is
# meant to be VERIFIED BY A HUMAN before the translation stage runs. A model
# fed corrupted OCR produces a fluent, confident, wrong translation.
#
#   tr-pdf --ocr-only in.pdf     # stage 1: OCR, then go read the text
#   tr-pdf in.pdf out.docx       # both stages
#
# The text layer comes from tr-ocrtext, which keeps Tesseract's per-word
# confidence and replaces anything below the floor with OCR_ILLEGIBLE, rather
# than from pdftotext, which cannot tell a certain word from a guessed one.

set -euo pipefail
BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# A TR_PROJECTS pointing somewhere OTHER than the real container lifts the
# mount requirement; merely being set does not.
#
# This used to read ${TR_PROJECTS+y}, which tested only whether the variable
# existed. tr-setup exported it to this very default in ~/.bashrc, so every
# interactive shell held the hatch open on the real container permanently.
# tr-run and trlib were both corrected to compare resolved paths; this script
# kept the old test while its comment claimed to match them, which is the
# worst of both -- a guard that reads as present and is not. Same rule
# everywhere, or the escape hatch works in one half of the kit and not the
# other.
DEFAULT_PROJECTS="$HOME/translation-work/confidential-projects"
TR_PROJECTS="${TR_PROJECTS:-$DEFAULT_PROJECTS}"
if [[ "$(readlink -f "$TR_PROJECTS")" == "$(readlink -f "$DEFAULT_PROJECTS")" ]]; then
  PROJECTS_OVERRIDDEN=""
else
  PROJECTS_OVERRIDDEN="y"
fi

# The OCR text layer is the whole document in plain text -- the single most
# sensitive artefact this pipeline produces. It belongs inside the container
# and nowhere else, so resolve the project the same way tr-run does and
# refuse rather than fall back to a default path.
if [[ -z "${TR_ROOT:-}" ]]; then
  [[ -n "${PROJECTS_OVERRIDDEN:-}" ]] || mountpoint -q "$TR_PROJECTS" 2>/dev/null || {
    echo "container NOT mounted: $TR_PROJECTS" >&2
    echo "The OCR text layer is full plaintext of the document; it must not" >&2
    echo "be written outside the encrypted container. Refusing." >&2
    echo "  check:  case-status" >&2
    echo "  open:   case-open" >&2
    exit 2; }
  ACTIVE="$(tr -d '[:space:]' < "$TR_PROJECTS/.active" 2>/dev/null)"
  [[ -n "$ACTIVE" ]] || { echo "no active project. run: tr-project <name>" >&2; exit 2; }
  TR_ROOT="$TR_PROJECTS/$ACTIVE"
fi
export TR_ROOT
OCRDIR="$TR_ROOT/work/ocr"
LANGS="${TR_OCR_LANGS:-slv+eng}"
mkdir -p "$OCRDIR"

ONLY=0; [[ "${1:-}" == "--ocr-only" ]] && { ONLY=1; shift; }
IN="$1"; OUT="${2:-}"
# Cache key: the path relative to source/, flattened, not the basename.
# Keying on the basename meant drop-A/zapisnik.pdf and drop-B/zapisnik.pdf
# shared one cache entry -- the second file would have been "translated"
# from the first one's text layer, silently and with no sign of it in the
# output. Drops arrive nested and filenames are preserved by design, so
# duplicate names across drops are expected rather than unlucky.
rel="${IN#"$TR_ROOT/source/"}"
if [[ "$rel" == "$IN" ]]; then
  # Not under source/ -- an ad hoc --ocr-only on some other path. Keep it
  # readable but make it unique to the full path.
  rel="$(basename "${IN%.*}")-$(printf '%s' "$IN" | sha256sum | cut -c1-8)"
else
  rel="${rel%.*}"
fi
base="${rel//\//__}"
pdf="$OCRDIR/$base.ocr.pdf"
txt="$OCRDIR/$base.txt"

if [[ ! -f "$pdf" ]]; then
  echo "  OCR ($LANGS): $(basename "$IN")"
  ocrmypdf -l "$LANGS" --rotate-pages --deskew --clean \
           --output-type pdfa --quiet "$IN" "$pdf"
else
  echo "  OCR cached: $(basename "$pdf")"
fi
# Not pdftotext. It reads the text layer ocrmypdf embedded and cannot tell a
# word Tesseract was sure of from one it invented -- and the forms in this
# corpus are hand-filled, where inventing is exactly what it does. tr-ocrtext
# keeps the per-word confidence and marks what could not be read, so a
# scrawled amount reaches the translator as OCR_ILLEGIBLE rather than as a
# confident figure nobody has reason to doubt.
"$BIN/tr-ocrtext" "$pdf" "$txt"

wc_w=$(wc -w < "$txt")
echo "  text layer: $txt  ($wc_w words)"

if [[ $ONLY -eq 1 ]]; then
  echo
  echo "  VERIFY THIS TEXT AGAINST THE PAGE IMAGES BEFORE TRANSLATING."
  echo "  Pay particular attention to: names, dates, case numbers, amounts,"
  echo "  and the characters c/s/z with carons."
  echo
  # --ocr-only is normally given just the input, so $OUT is empty and the
  # hint used to read: tr-pdf 'in.pdf' ''. Suggest the deliverable name the
  # second stage would actually produce.
  echo "  then:  tr-pdf '$IN' '${OUT:-$TR_ROOT/translated/$base.docx}'"
  exit 0
fi

[[ -n "$OUT" ]] || { echo "output path required" >&2; exit 1; }
"$BIN/tr-txt" "$txt" "$OUT"
