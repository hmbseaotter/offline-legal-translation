#!/usr/bin/env bash
# tr-pdf - OCR a scanned PDF, then translate the text into a .docx.
#
# Usage:  tr-pdf [--ocr-only] <input.pdf> [output.docx]
#
# Two-stage by design. The OCR text layer is written to work/ocr/ and is
# meant to be VERIFIED BY A HUMAN before the translation stage runs. A model
# fed corrupted OCR produces a fluent, confident, wrong translation.
#
#   tr-pdf --ocr-only in.pdf     # stage 1: OCR, then go read the text
#   tr-pdf in.pdf out.docx       # both stages
#
# The text layer comes from tr-ocrtext, which keeps Tesseract's per-word
# confidence and replaces anything below the floor with OCR_ILLEGIBLE, rather
# than from pdftotext, which cannot tell a certain word from a guessed one.

set -euo pipefail
BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$BIN/../lib/guard.sh"
# The OCR text layer is the whole document in plain text -- the single most
# sensitive artefact this pipeline produces.
tr_guard_resolve_root \
  "The OCR text layer is full plaintext of the document; it must not be written outside the encrypted container."
OCRDIR="$TR_ROOT/work/ocr"
LANGS="${TR_OCR_LANGS:-slv+eng}"
mkdir -p "$OCRDIR"

ONLY=0; [[ "${1:-}" == "--ocr-only" ]] && { ONLY=1; shift; }
IN="$1"; OUT="${2:-}"
# Cache key: the path relative to source/, flattened, not the basename.
# Keying on the basename meant drop-A/zapisnik.pdf and drop-B/zapisnik.pdf
# shared one cache entry -- the second file would have been "translated"
# from the first one's text layer, silently and with no sign of it in the
# output. Drops arrive nested and filenames are preserved by design, so
# duplicate names across drops are expected rather than unlucky.
rel="${IN#"$TR_ROOT/source/"}"
if [[ "$rel" == "$IN" ]]; then
  # Not under source/ -- an ad hoc --ocr-only on some other path. Keep it
  # readable but make it unique to the full path.
  rel="$(basename "${IN%.*}")-$(printf '%s' "$IN" | sha256sum | cut -c1-8)"
else
  rel="${rel%.*}"
fi
base="${rel//\//__}"
pdf="$OCRDIR/$base.ocr.pdf"
txt="$OCRDIR/$base.txt"

# Is this a scan at all?
#
# Not every PDF in a bundle is. A born-digital document -- one exported from
# a word processor rather than photographed -- already carries exact text,
# and OCR can only make it worse: rasterising a perfect text layer and
# reading it back with Tesseract introduces errors that were never in the
# document. On a drop of 89 files this was the majority case and the
# pipeline treated all of them as scans.
#
# It also aborted on them. ocrmypdf refuses a page that already has text
# unless told what to do about it, so every such file failed with
# PriorOcrFoundError and produced nothing.
#
# GlyphLessFont is the tell. Tesseract writes its invisible text layer in
# that font, so its presence means the text is somebody's OCR rather than
# the document's own -- and OCR of unknown provenance is worth redoing,
# because ours at least records which words it was unsure of.
if [[ ! -f "$txt" ]]; then
  # Braces, not `|| echo 0`. This script runs under `set -o pipefail`, so a
  # pdftotext that exits non-zero fails the whole pipeline even though wc
  # succeeded and printed a number -- the fallback then fired too and the
  # variable held "0\n0", which [[ ]] rejects as an arithmetic expression.
  # Swallowing the failure inside the braces keeps exactly one number.
  native_words=$( { pdftotext -layout "$IN" - 2>/dev/null || true; } | wc -w )
  glyphless=$( { pdffonts "$IN" 2>/dev/null || true; } | grep -ci glyphless || true )

  if [[ "$native_words" -ge 50 && "${glyphless:-0}" -eq 0 ]]; then
    echo "  born-digital: $native_words words of real text, no OCR needed"
    pdftotext -layout "$IN" "$txt"
  else
    if [[ ! -f "$pdf" ]]; then
      echo "  OCR ($LANGS): $(basename "$IN")"
      # --skip-text so a mixed document -- some pages scanned, some native --
      # is processed rather than refused. Not --redo-ocr, which ocrmypdf
      # rejects alongside --deskew and --clean, and those are what make a
      # crooked scan readable in the first place.
      ocrmypdf -l "$LANGS" --rotate-pages --deskew --clean --skip-text \
               --output-type pdfa --quiet "$IN" "$pdf"
    else
      echo "  OCR cached: $(basename "$pdf")"
    fi
    # Not pdftotext here. It reads the text layer ocrmypdf embedded and
    # cannot tell a word Tesseract was sure of from one it invented -- and
    # the forms in this corpus are hand-filled, where inventing is exactly
    # what it does. tr-ocrtext keeps the per-word confidence and marks what
    # could not be read, so a scrawled amount reaches the translator as
    # OCR_ILLEGIBLE rather than as a confident figure nobody has reason to
    # doubt.
    "$BIN/tr-ocrtext" "$pdf" "$txt"
  fi
else
  echo "  text layer cached: $(basename "$txt")"
fi

wc_w=$(wc -w < "$txt")
echo "  text layer: $txt  ($wc_w words)"

if [[ $ONLY -eq 1 ]]; then
  echo
  echo "  VERIFY THIS TEXT AGAINST THE PAGE IMAGES BEFORE TRANSLATING."
  echo "  Pay particular attention to: names, dates, case numbers, amounts,"
  echo "  and the characters c/s/z with carons."
  echo
  # --ocr-only is normally given just the input, so $OUT is empty and the
  # hint used to read: tr-pdf 'in.pdf' ''. Suggest the deliverable name the
  # second stage would actually produce.
  echo "  then:  tr-pdf '$IN' '${OUT:-$TR_ROOT/translated/$base.docx}'"
  exit 0
fi

[[ -n "$OUT" ]] || { echo "output path required" >&2; exit 1; }
"$BIN/tr-txt" "$txt" "$OUT"
