#!/usr/bin/env python3
"""tr-xlsx - translate a spreadsheet via unique-string deduplication.

Usage:  tr-xlsx <input.xlsx> <output.xlsx> [--from sl] [--to en]
                [--cols B,D,E]   restrict to these columns
                [--survey]       report redundancy and exit, translating nothing

Large tables are dominated by repeated categorical values. Each distinct
string is translated once and written back by lookup, which collapses the
work and guarantees identical cells get identical translations.
"""
import os, sys, argparse, collections

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "lib"))
import trlib
import openpyxl
from openpyxl.utils import column_index_from_string

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("inp"); ap.add_argument("out", nargs="?")
    ap.add_argument("--from", dest="src", default=os.environ.get("TR_SRC", "sl"))
    ap.add_argument("--to", dest="tgt", default=os.environ.get("TR_TGT", "en"))
    ap.add_argument("--cols", default=None)
    ap.add_argument("--survey", action="store_true")
    a = ap.parse_args()

    cols = None
    if a.cols:
        cols = {column_index_from_string(c.strip().upper())
                for c in a.cols.split(",")}

    wb = openpyxl.load_workbook(a.inp)
    targets, counter = [], collections.Counter()

    for ws in wb.worksheets:
        for row in ws.iter_rows():
            for cell in row:
                if cols and cell.column not in cols:
                    continue
                if not isinstance(cell.value, str):
                    continue
                # A formula is not text to translate, it is code. openpyxl
                # hands back the formula source ("=SUM(B1:B9)"), which
                # is_translatable happily accepts because it contains letters
                # -- so it went to the model and came back as prose, and the
                # cell stopped being a formula. On a financial exhibit that
                # silently destroys the arithmetic the document is about.
                #
                # The computed value is not translated either, and cannot be:
                # writing a translation into the cell would overwrite the
                # formula. Anything derived stays derived.
                if cell.data_type == "f" or cell.value.lstrip().startswith("="):
                    continue
                v = cell.value.strip()
                if not trlib.is_translatable(v):
                    continue
                targets.append(cell)
                counter[v] += 1

    # What a cell walk does not reach, said once where it is measured rather
    # than left for the reviewer to discover in the deliverable:
    #
    #   sheet (tab) names   Prihodki stays Prihodki. Renaming them would
    #                       break every formula that references a sheet by
    #                       name, so it is a decision, not an oversight.
    #   cell comments       openpyxl carries them through untouched.
    #   headers and footers  likewise.
    #   text boxes, shapes, chart titles  not part of the cell grid at all.
    #
    # All of it is Slovene in an English deliverable, and all of it is
    # visible to whoever opens the file.
    uniq = list(counter)
    total = len(targets)
    skipped = []
    if any(ws.title for ws in wb.worksheets):
        skipped.append(f"{len(wb.worksheets)} sheet name(s)")
    ncom = sum(1 for ws in wb.worksheets for row in ws.iter_rows()
               for c in row if getattr(c, "comment", None))
    if ncom:
        skipped.append(f"{ncom} cell comment(s)")
    ratio = (len(uniq) / total) if total else 0
    print(f"  text cells: {total:,}   unique: {len(uniq):,}   ratio: {ratio:.1%}",
          file=sys.stderr)
    if skipped:
        print(f"  not translated: {', '.join(skipped)} - a cell walk does not "
              f"reach them", file=sys.stderr)

    if a.survey or not a.out:
        print("\n  most repeated values:", file=sys.stderr)
        for s, n in counter.most_common(20):
            print(f"    {n:6,}  {s[:70]}", file=sys.stderr)
        # Measured on this machine with gams3:q8, not assumed. 12 samples of
        # real pipeline traffic: prefill 7.00 tok/s, generation 2.20 tok/s,
        # 48.3 s of wall clock per segment end to end.
        #
        # Estimating from a generation rate alone was optimistic by ~5x,
        # because most of a segment's cost is not generation. Every call
        # re-reads a ~200-token system prompt at 7 tok/s -- about 28 s -- and
        # pays it whether the cell holds a sentence or two words. So the
        # figure below is a per-segment cost, not tokens over a rate. Short
        # cells are cheaper than this, but only by the generation part; the
        # prefill floor is paid regardless.
        SEC_PER_SEGMENT = 48.3
        est = len(uniq) * SEC_PER_SEGMENT / 3600
        print(f"\n  rough translation time at {SEC_PER_SEGMENT:.0f}s/segment "
              f"(measured): {est:.1f} h "
              f"(vs {total * SEC_PER_SEGMENT / 3600:.0f} h without dedup)",
              file=sys.stderr)
        return

    # No first-mention bracketing here, deliberately. A spreadsheet is
    # translated through a unique-string map: one translation is written back
    # to every cell holding that string. Bracketing the "first" one would
    # bracket all of them, because they are the same string. Institution
    # names in a table are also a column value rather than running prose,
    # where the source form beside every entry would be noise. If a matter
    # needs it in a table, it is a manual edit on the deliverable.
    gloss = trlib.load_glossary()
    # Batched. Cells are the strongest case for it: each is independent, most
    # are a few words, and a run of 370 of them cost 22,075 seconds one at a
    # time -- a minute each for strings a person reads in a second, because
    # the per-call prefill dwarfs the generation.
    vals = trlib.ollama_translate_many(
        uniq, a.src, a.tgt, gloss,
        report=lambda d, n, t: trlib.progress(d, n, t[:48]))
    mapping = dict(zip(uniq, vals))

    for cell in targets:
        v = cell.value.strip()
        if v in mapping:
            cell.value = trlib.xml_safe(mapping[v])

    os.makedirs(os.path.dirname(os.path.abspath(a.out)), exist_ok=True)
    wb.save(a.out)
    print(f"  -> {a.out}", file=sys.stderr)

if __name__ == "__main__":
    main()
