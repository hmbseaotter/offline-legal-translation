#!/usr/bin/env python3
"""tr-lint - deterministic checks over the translation memory and outputs.

Usage:  tr-lint [--tsv report.tsv] [--all-versions]

Runs no model. Takes seconds. Catches the error classes a language model is
structurally worst at noticing. The output is a prioritized worklist for the
reviewer, not a pass/fail gate.

Checks:
  NUM   a number present in source is absent from target, or vice versa,
        compared as values with each side read in its own notation
  LONG  the target is far longer than the source: text the model added
  GLOSS a glossary term's agreed translation was not used
  NONTR a string marked non-translatable was altered
  DEC   an English 5.10, 3.2 or 14.30 was written as a decimal: an amount,
        or a section, clause or time turned into one?
  FAIL  [TRANSLATION FAILED] in a deliverable or the memory: a segment the
        model could not translate
  EMPTY empty or whitespace-only target
  ECHO  target identical to source (possible untranslated passthrough)
  INCON the same source segment translated two different ways
"""
import os, re, sys, sqlite3, argparse, collections

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "lib"))
import trlib

# Numbers are compared as values, with dates, times and separators folded onto
# one spelling first -- see trlib.compare_numbers, which the invention retry
# and reference alignment use too, so none of them can disagree about whether
# two sentences carry the same numbers.

FAILED = "[TRANSLATION FAILED]"
W = "{http://schemas.openxmlformats.org/wordprocessingml/2006/main}"


def deliverable_failures():
    """(deliverable, what follows the marker, the text holding it) for every
    [TRANSLATION FAILED] under translated/. A failed segment is never stored in
    the memory, so the deliverables are the one place it can be seen. A Word
    file is read part by part -- body, headers, footers -- so a nested table
    or a footer is not missed; a workbook cell by cell."""
    import zipfile
    root = trlib.path("translated")
    out = []
    for dp, _dirs, files in os.walk(root):
        for f in sorted(files):
            p, texts = os.path.join(dp, f), []
            try:
                if f.lower().endswith(".docx"):
                    from lxml import etree
                    with zipfile.ZipFile(p) as z:
                        for part in z.namelist():
                            if re.fullmatch(r"word/(document|header\d*|footer\d*)\.xml", part):
                                texts += ["".join(t.text or "" for t in par.iter(W + "t"))
                                          for par in etree.fromstring(z.read(part)).iter(W + "p")]
                elif f.lower().endswith(".xlsx"):
                    import openpyxl
                    wb = openpyxl.load_workbook(p, read_only=True)
                    texts = [v for ws in wb.worksheets for row in ws.iter_rows(values_only=True)
                             for v in row if isinstance(v, str)]
                    wb.close()
            except Exception:
                continue
            for text in texts:
                for piece in text.split(FAILED)[1:]:
                    out.append((os.path.relpath(p, root), piece.strip(), text))
    return out


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--tsv", default=trlib.path("work", "lint-report.tsv"))
    ap.add_argument("--all-versions", action="store_true",
                    help="include segments from superseded models and prompt "
                         "versions (default: only what tr-run would use now)")
    a = ap.parse_args()

    failed = deliverable_failures()
    dbp = trlib.path("work", "tm.sqlite")
    if not os.path.exists(dbp) and not failed:
        sys.exit("no translation memory yet - nothing to check")
    db = trlib._db()
    # The memory keys on (direction, model, prompt_version, source), so a
    # prompt-version bump leaves the old rows in place -- correctly, since
    # invariant 7 says they must not be reused. Linting across all of them
    # meant every segment retranslated under a new prompt appeared twice and
    # reported as INCON: bumping the version, which invariant 7 requires,
    # made the whole corpus look inconsistent. The default is what tr-run
    # would actually reuse today.
    gloss = trlib.load_glossary()
    if a.all_versions:
        rows = db.execute(
            "SELECT src, tgt, direction, model, prompt_version FROM tm").fetchall()
    else:
        # The glossary is part of the key too, so a term edit also leaves the
        # superseded rows behind. Filtering on model and prompt version alone
        # would let both the old and the new rendering through and report the
        # segment as INCON -- the same false alarm prompt bumps used to cause.
        # Keep only what tr-run would actually reuse today.
        # No filter on model or version in SQL: both are chosen per
        # direction, and the key carries the ones routed for its direction.
        raw = db.execute(
            "SELECT key, src, tgt, direction, model, prompt_version FROM tm"
            ).fetchall()
        rows = [(src, tgt, direction, model, pver)
                for key, src, tgt, direction, model, pver in raw
                if key == trlib.tm_current_key(src, direction, gloss)]
        if not rows and not failed:
            sys.exit(f"no segments for model {trlib.MODEL} prompt "
                     f"{trlib.PROMPT_VERSION} - run tr-run, or use "
                     f"--all-versions to inspect superseded ones")
    db.close()
    findings = [("FAIL", f"in {rel}", seg, text) for rel, seg, text in failed]
    by_src = collections.defaultdict(set)

    for src, tgt, direction, model, pver in rows:
        # Grouped by model and prompt version too: INCON should mean "the
        # same input, under identical conditions, produced two different
        # outputs", not "the prompt changed since last time".
        by_src[(src, direction, model, pver)].add(tgt)

        if tgt.startswith("[TRANSLATION FAILED]"):
            findings.append(("FAIL", "translation errored", src, tgt)); continue
        if not tgt.strip():
            findings.append(("EMPTY", "empty target", src, tgt)); continue
        if tgt.strip() == src.strip() and trlib.is_translatable(src):
            findings.append(("ECHO", "target identical to source", src, tgt))

        sl, tl = trlib.split_direction(direction)
        lost, added = trlib.compare_numbers(src, tgt, sl, tl)
        if lost:
            findings.append(("NUM", "missing from target: " + ", ".join(sorted(lost)), src, tgt))
        if added:
            findings.append(("NUM", "not in source: " + ", ".join(sorted(added)), src, tgt))
        # The same test tr-run now applies before caching. Here it finds the
        # inventions already in a memory written before that test existed.
        if trlib.implausible(src, tgt):
            findings.append(("LONG", "far longer than the source - text added",
                             src, tgt))
        for n in trlib.decimal_rewrites(src, tgt, *trlib.split_direction(direction)):
            findings.append(("DEC", f"'{n}' written as a decimal - an amount, "
                                    f"or a reference or time?", src, tgt))

        low_s = src.lower()
        for term, want in gloss:
            if term.lower() in low_s and want.lower() not in tgt.lower():
                findings.append(("GLOSS", f"'{term}' should render as '{want}'", src, tgt))

        # finditer, not findall: findall yields the capture groups whenever a
        # pattern has any, so '123-45/2024-6' arrived here as '-6' and
        # '12.450,00 EUR' as 'EUR'. The check then tested text that was never
        # at issue -- raising findings for fragments nothing had touched while
        # missing the identifiers that had actually been dropped. group(0) is
        # the match. The patterns overlap by design -- 'KZ-1' is matched by
        # both statute rules and 'EUR' sits inside the amount rule's match --
        # so a fragment already covered by a longer one is dropped rather
        # than reported twice. File order puts the specific rules first.
        seen = set()
        for pat in trlib.nontranslatables():
            for m in pat.finditer(src):
                frag = m.group(0)
                if not frag or any(frag in s for s in seen):
                    continue
                seen.add(frag)
                # Verbatim is one acceptable outcome; the locale-converted
                # form is the other, and in Swiss German so are the forms its
                # conventions allow. Dates and amounts are matched by these
                # patterns but are required to change -- checking only for
                # the source spelling reported every converted date as
                # dropped, which is the same false alarm the NUM check had.
                if not trlib.nontranslatable_kept(frag, tgt, sl, tl):
                    findings.append(("NONTR", f"'{frag}' altered or dropped", src, tgt))

    for (src, direction, _model, _pver), tgts in by_src.items():
        if len(tgts) > 1:
            findings.append(("INCON", f"{len(tgts)} different translations",
                             src, " || ".join(sorted(tgts))))

    counts = collections.Counter(f[0] for f in findings)
    order = ["FAIL", "NUM", "LONG", "NONTR", "DEC", "INCON", "GLOSS", "ECHO", "EMPTY"]
    findings.sort(key=lambda f: (order.index(f[0]) if f[0] in order else 99, f[2]))

    os.makedirs(os.path.dirname(a.tsv), exist_ok=True)
    with open(a.tsv, "w", encoding="utf-8") as fh:
        fh.write("check\tdetail\tsource\ttarget\n")
        for c, d, s, t in findings:
            fh.write("\t".join(x.replace("\t", " ").replace("\n", " ")
                               for x in (c, d, s, t)) + "\n")

    print(f"segments checked: {len(rows):,}")
    print(f"findings:         {len(findings):,}")
    for k in order:
        if counts.get(k):
            print(f"  {k:6} {counts[k]:,}")
    print(f"\nreport: {a.tsv}")
    if findings:
        print("\nfirst few:")
        for c, d, s, t in findings[:8]:
            print(f"  [{c}] {d}\n     src: {s[:80]}\n     tgt: {t[:80]}")

if __name__ == "__main__":
    main()
