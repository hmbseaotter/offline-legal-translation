#!/usr/bin/env python3
"""tr-status - what is translated, what is missing, what is stale.

Compares source/ against translated/ by filename. Filenames are preserved,
so the comparison is close to a plain set difference -- with the exceptions
trlib.target_names() accounts for: TR_SUFFIX, the formats whose deliverable
is a .docx (a scanned PDF cannot be regenerated as a PDF), and files in one
folder that would otherwise deliver under one name.

A deliverable is stale when anything that made it has changed since tr-run
wrote it, as work/deliverables.tsv records. trlib.deliverable_plan() decides
that, for tr-run as well as here.

Usage:  tr-status [--missing]      # --missing prints bare paths only
"""
import os, sys

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "lib"))
import trlib

SRC, TGT = trlib.path("source"), trlib.path("translated")

def walk(root):
    out = set()
    for dp, _, fns in os.walk(root):
        for fn in fns:
            if fn.startswith(("~$", ".")):
                continue
            out.add(os.path.relpath(os.path.join(dp, fn), root))
    return out

def main():
    bare = "--missing" in sys.argv
    if not os.path.isdir(SRC):
        sys.exit(f"no source directory: {SRC}")
    src = walk(SRC)
    src_all = set(src)          # before triage narrows it; see orphans below
    tgt = walk(TGT) if os.path.isdir(TGT) else set()

    # Only the files triage found in the source language are ours to finish.
    # Counting a Croatian exhibit as "missing" would leave every project
    # permanently short of complete, which is the same way PDFs used to
    # report before target_name() accounted for them.
    want = os.environ.get("TR_SRC", "sl")
    in_scope = trlib.manifest_paths(want)
    held_back = 0
    if in_scope is not None:
        keep = set(in_scope)
        held_back = len(src) - len(src & keep)
        src &= keep

    names, clashes = trlib.target_names(src_all)
    plan = trlib.deliverable_plan(sorted(src), TGT)
    done, missing, stale, held, edited = [], [], [], [], []
    for rel in sorted(src):
        name, action, detail = plan[rel]
        if action == "draft":
            missing.append(rel)
        elif action == "redo":
            stale.append(f"{rel}   ({detail})")
        elif action == "held":
            held.append(f"{rel}   ({name} holds {detail})")
        elif action == "edited":
            edited.append(f"{rel}   ({detail})")
        elif action == "current":
            done.append(rel)
    clashing = {rel for group in clashes for rel in group}

    if bare:
        for r in missing:
            print(os.path.join(SRC, r))
        return

    # An orphan is a deliverable with no source behind it at all -- so it is
    # measured against every file in source/, not against the triage-narrowed
    # set. Comparing with the narrowed set reported every output of a
    # `tr-run --all` as orphaned, which was plainly untrue: those files have
    # sources, just ones triage held back.
    orphans = sorted(tgt - set(names.values()))

    print(f"project:    {trlib.project_name()}")
    if in_scope is None:
        print(f"source:     {len(src)} files   (no inventory - run tr-inventory)")
    else:
        print(f"source:     {len(src)} files in {want}"
              f"   ({held_back} other-language held back by triage)")
    print(f"translated: {len(done)}")
    print(f"missing:    {len(missing)}")
    if stale:
        print(f"stale:      {len(stale)}  (something that made it has changed; "
              f"tr-run drafts it again)")
    if edited:
        print(f"edited:     {len(edited)}  (changed after drafting, and stale; "
              f"tr-run keeps it until it is moved aside)")
    if held:
        print(f"wrong file: {len(held)}  (the deliverable holds another "
              f"source's translation)")
    if clashing:
        print(f"clashing:   {len(clashing)}  (sharing one deliverable name; "
              f"tr-run refuses them)")
    if orphans:
        print(f"orphaned:   {len(orphans)}  (in translated/, no matching source)")
    print()
    for label, items in (("MISSING", missing), ("STALE", stale),
                         ("EDITED", edited), ("WRONG FILE", held),
                         ("CLASHING", [", ".join(g) for g in clashes]),
                         ("ORPHANED", orphans)):
        if items:
            print(f"{label}:")
            for r in items:
                print(f"  {r}")
            print()
    if done and "-v" in sys.argv:
        print("DONE:")
        for r in done:
            print(f"  {r}")

if __name__ == "__main__":
    main()
