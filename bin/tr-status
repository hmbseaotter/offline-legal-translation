#!/usr/bin/env python3
"""tr-status - what is translated, what is missing, what is stale.

Compares source/ against translated/ by filename. Filenames are preserved,
so the comparison is close to a plain set difference -- with two exceptions
that trlib.target_name() accounts for: TR_SUFFIX, and the formats whose
deliverable is a .docx (a scanned PDF cannot be regenerated as a PDF).

Usage:  tr-status [--missing]      # --missing prints bare paths only
"""
import os, sys, time

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "lib"))
import trlib

SRC, TGT = trlib.path("source"), trlib.path("translated")

# Shared with bin/tr-run so the name written and the name looked for agree.
target_name = trlib.target_name

def walk(root):
    out = set()
    for dp, _, fns in os.walk(root):
        for fn in fns:
            if fn.startswith(("~$", ".")):
                continue
            out.add(os.path.relpath(os.path.join(dp, fn), root))
    return out

def main():
    bare = "--missing" in sys.argv
    if not os.path.isdir(SRC):
        sys.exit(f"no source directory: {SRC}")
    src = walk(SRC)
    src_all = set(src)          # before triage narrows it; see orphans below
    tgt = walk(TGT) if os.path.isdir(TGT) else set()

    # Only the files triage found in the source language are ours to finish.
    # Counting a Croatian exhibit as "missing" would leave every project
    # permanently short of complete, which is the same way PDFs used to
    # report before target_name() accounted for them.
    want = os.environ.get("TR_SRC", "sl")
    in_scope = trlib.manifest_paths(want)
    held = 0
    if in_scope is not None:
        keep = set(in_scope)
        held = len(src) - len(src & keep)
        src &= keep

    done, missing, stale = [], [], []
    for rel in sorted(src):
        t = target_name(rel)
        tp, sp = os.path.join(TGT, t), os.path.join(SRC, rel)
        if t not in tgt:
            missing.append(rel)
        elif os.path.getmtime(tp) < os.path.getmtime(sp):
            stale.append(rel)
        else:
            done.append(rel)

    if bare:
        for r in missing:
            print(os.path.join(SRC, r))
        return

    # An orphan is a deliverable with no source behind it at all -- so it is
    # measured against every file in source/, not against the triage-narrowed
    # set. Comparing with the narrowed set reported every output of a
    # `tr-run --all` as orphaned, which was plainly untrue: those files have
    # sources, just ones triage held back.
    orphans = sorted(tgt - {target_name(r) for r in src_all})

    print(f"project:    {trlib.project_name()}")
    if in_scope is None:
        print(f"source:     {len(src)} files   (no inventory - run tr-inventory)")
    else:
        print(f"source:     {len(src)} files in {want}"
              f"   ({held} other-language held back by triage)")
    print(f"translated: {len(done)}")
    print(f"missing:    {len(missing)}")
    if stale:
        print(f"stale:      {len(stale)}  (source newer than translation)")
    if orphans:
        print(f"orphaned:   {len(orphans)}  (in translated/, no matching source)")
    print()
    for label, items in (("MISSING", missing), ("STALE", stale), ("ORPHANED", orphans)):
        if items:
            print(f"{label}:")
            for r in items:
                print(f"  {r}")
            print()
    if done and "-v" in sys.argv:
        print("DONE:")
        for r in done:
            print(f"  {r}")

if __name__ == "__main__":
    main()
