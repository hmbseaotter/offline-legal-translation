#!/usr/bin/env bash
# case-open - unlock and mount the encrypted case container.
#
# Usage:  case-open
#
# Refuses to run if a Claude Code session is active, because the point of
# the container is that assistant sessions and case data are never both
# present at once.

set -euo pipefail
IMG="${CASE_IMG:-$HOME/.case/confidential.luks}"
MAP="${CASE_MAP:-casedata}"
MNT="${CASE_MNT:-$HOME/translation-work/confidential-projects}"

if [[ ! -f "$IMG" ]]; then
  echo "container not found: $IMG" >&2
  echo "run case-init first" >&2
  exit 1
fi

if mountpoint -q "$MNT"; then
  echo "already mounted at $MNT"
  exit 0
fi

# Guard: do not open case data while an assistant session is running. This is
# the half of the mutual exclusion that faces this direction; case-guard
# refuses to start Claude Code while the container is mounted. Neither alone
# is enough -- without both you would simply do them in the other order.
#
# The message names the processes because "exit Claude Code" is not always
# actionable advice: the desktop application runs Claude Code as a child
# process literally named `claude`, so closing a conversation may leave it
# alive, and the operator is left guessing what is still holding the lock.
if pgrep -x claude >/dev/null 2>&1; then
  {
    echo
    echo "  ┌──────────────────────────────────────────────────────────────┐"
    echo "  │  BLOCKED: a Claude session is still running."
    echo "  │"
    echo "  │  ALL Claude sessions must be closed before the container can"
    echo "  │  be opened. Case material and assistant sessions are never"
    echo "  │  both present at once -- that is the whole point of the"
    echo "  │  container, and this check is what enforces it."
    echo "  │"
    echo "  │  Closing the conversation is often NOT enough: the desktop"
    echo "  │  application keeps a 'claude' child process alive. Quit the"
    echo "  │  application itself, and close any terminal or IDE window"
    echo "  │  with a session attached."
    echo "  │"
    echo "  │  Still holding it open:"
    for pid in $(pgrep -x claude); do
      parent=$(awk '/^PPid:/{print $2}' "/proc/$pid/status" 2>/dev/null)
      pname=$(cat "/proc/$parent/comm" 2>/dev/null || echo "?")
      printf '  │    pid %-7s (started by %s)\n' "$pid" "$pname"
    done
    echo "  │"
    echo "  │  Confirm it is clear, then run case-open again:"
    echo "  │      pgrep -x claude || echo clear"
    echo "  └──────────────────────────────────────────────────────────────┘"
    echo
  } >&2
  exit 2
fi

# The bare mountpoint is immutable so nothing can write to it while the
# container is closed. Lift that only for the duration of the mount.
sudo chattr -i "$MNT" 2>/dev/null || true

echo "unlocking $IMG"
sudo cryptsetup luksOpen "$IMG" "$MAP"
sudo mount "/dev/mapper/$MAP" "$MNT"
sudo chown "$(id -u):$(id -g)" "$MNT"

echo "mounted: $MNT"
df -h "$MNT" | tail -1
echo
echo "Close it when finished:  case-close"
