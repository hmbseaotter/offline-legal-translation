#!/usr/bin/env python3
"""tr-project - list, show, or switch the active confidential project.

Usage:
  tr-project                 show active project and list all
  tr-project <name>          make <name> active
  tr-project --new <name>    scaffold a new project and make it active
  tr-project --none          clear the active project

Every other tool reads the active project, so setting it wrong is the one
new way this layout can go wrong. tr-run prints the active project before
doing anything, and refuses to run when none is set.
"""
import os, sys, shutil

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "lib"))
import trlib

P = trlib.PROJECTS
MARK = os.path.join(P, ".active")
KIT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..")

SUBDIRS = ["source", "translated", "work/ocr", "logs", "glossary", "prompts"]

def container_open():
    # Not isdir(): the mountpoint exists whether or not the container is
    # open, so isdir() would scaffold a new project -- and every file later
    # put in it -- onto the bare unencrypted directory. See trlib.
    return trlib.PROJECTS_OVERRIDDEN or trlib.container_mounted()

def active():
    if os.path.exists(MARK):
        return open(MARK, encoding="utf-8").read().strip() or None
    return None

def projects():
    if not container_open():
        return []
    return sorted(d for d in os.listdir(P)
                  if os.path.isdir(os.path.join(P, d))
                  and not d.startswith((".", "_")))

def ensure_shared():
    """Seed the shared layer with curated terminology, and nothing else.

    base.tsv is copied because it is data the operator curates and there is
    no in-code default: the copy in the container is the only copy there is.

    The prompt and the non-translatable patterns are NOT copied, and this
    mattered more here than in case-init: this runs on every new project, so
    a matter created a year from now would still have been handed whatever
    the kit said the first time any project was made. A copy of the prompt in
    _shared overrides the one compiled into trlib, and a copy of the patterns
    shadows nothing but duplicates everything -- trlib reads the kit's file
    as its base layer for exactly that reason. Later corrections reach every
    matter because there is no frozen copy in the way.

    An override placed in _shared deliberately is still honoured; it is being
    created automatically that was wrong.
    """
    sd = trlib.SHARED
    os.makedirs(os.path.join(sd, "glossary"), exist_ok=True)
    base = os.path.join(sd, "glossary", "base.tsv")
    if not os.path.exists(base):
        src = os.path.join(KIT, "glossary", "glossary.tsv")
        shutil.copy(src, base) if os.path.exists(src) else open(base, "w").close()

def create(name):
    root = os.path.join(P, name)
    if os.path.exists(root):
        sys.exit(f"project already exists: {root}")
    ensure_shared()
    for s in SUBDIRS:
        os.makedirs(os.path.join(root, s), exist_ok=True)
    with open(os.path.join(root, "glossary", "project.tsv"), "w",
              encoding="utf-8") as fh:
        fh.write("# Case-specific terms. Overrides _shared/glossary/base.tsv.\n"
                 "# source<TAB>target<TAB>note\n")
    with open(os.path.join(root, "project.conf"), "w", encoding="utf-8") as fh:
        fh.write(f"# {name}\n"
                 "# Sourced by tr-run. Uncomment and adjust as needed.\n"
                 "TR_SRC=sl\nTR_TGT=en\n"
                 "# TR_SUFFIX=_translated\n"
                 "TR_OCR_LANGS=slv+eng\n")
    print(f"created {root}")
    for s in SUBDIRS:
        print(f"  {s}/")
    return root

def set_active(name):
    if not os.path.isdir(os.path.join(P, name)):
        sys.exit(f"no such project: {name}\nrun: tr-project --new {name}")
    with open(MARK, "w", encoding="utf-8") as fh:
        fh.write(name + "\n")
    print(f"active project: {name}")
    print(f"  {os.path.join(P, name)}")

def main():
    args = sys.argv[1:]

    if not container_open():
        sys.exit(f"container not mounted: {P}\n"
                 "The directory may exist and still be empty of encryption.\n"
                 "  check:  case-status\n"
                 "  open:   case-open\n"
                 "  never set up:  case-init 40G")

    if args and args[0] == "--none":
        if os.path.exists(MARK):
            os.remove(MARK)
        print("active project cleared")
        return
    if args and args[0] == "--new":
        if len(args) < 2:
            sys.exit("usage: tr-project --new <name>")
        create(args[1]); set_active(args[1]); return
    if args:
        set_active(args[0]); return

    cur = active()
    print(f"container: {P}")
    print(f"active:    {cur or '(none set)'}")
    print()
    ps = projects()
    if not ps:
        print("no projects yet.  tr-project --new <name>")
        return
    for name in ps:
        r = os.path.join(P, name)
        ns = len([f for _, _, fs in os.walk(os.path.join(r, "source")) for f in fs])
        nt = len([f for _, _, fs in os.walk(os.path.join(r, "translated")) for f in fs])
        flag = "*" if name == cur else " "
        print(f" {flag} {name:<28} {ns:>4} source  {nt:>4} translated")

if __name__ == "__main__":
    main()
