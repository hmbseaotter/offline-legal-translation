#!/usr/bin/env bash
# tr-setup - one-time provisioning. Safe to re-run.
set -euo pipefail
KIT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="${TR_VENV:-$HOME/.translate-venv}"

echo "==> project data lives in the encrypted container, created separately"
echo "    container:  case-init"
echo "    projects:   tr-project --new <name>"

echo "==> system packages"
sudo apt update -qq
# lsof is not optional: case-close uses it to report which processes still
# hold the mount open. Without it that report is silently empty and you get
# a bare "target is busy" instead -- the exact failure case-close was
# written to explain.
#
# The hunspell dictionaries are what tr-inventory detects source language
# with -- not a spellchecker here, a word list. Without them triage cannot
# run and every file in a mixed client drop would be treated as Slovene.
#
# tesseract-ocr-hrv and -srp-latn are for the sampling pass only: a scanned
# PDF has no text to detect from, so tr-inventory OCRs a page or two with
# the languages combined and decides from that before the real OCR runs.
sudo apt install -y ocrmypdf poppler-utils \
     tesseract-ocr tesseract-ocr-slv tesseract-ocr-eng tesseract-ocr-deu \
     tesseract-ocr-hrv tesseract-ocr-srp-latn \
     hunspell-sl hunspell-hr hunspell-sr hunspell-hy hunspell-en-us \
     python3-pip python3-venv qpdf unpaper lsof

echo "==> python environment (outside the container, so it survives unmount)"
python3 -m venv "$VENV"
"$VENV/bin/pip" install -q --upgrade pip
"$VENV/bin/pip" install -q python-docx openpyxl

echo "==> swap check"
sw=$(free -m | awk '/^Swap:/{print $2}')
if [[ "$sw" -lt 4096 ]]; then
  echo "    WARNING: swap is ${sw}MB. Long unattended runs want >=8GB as a"
  echo "    safety net. See manual S2.3."
else
  echo "    swap ${sw}MB - ok"
fi

echo "==> config templates stay in the kit; case-init seeds _shared/ from them"

echo "==> PATH"
if ! grep -qF "$KIT/bin" "$HOME/.bashrc" 2>/dev/null; then
  echo "export PATH=\"$KIT/bin:\$PATH\"" >> "$HOME/.bashrc"
  echo "export TR_PROJECTS=\"\$HOME/translation-work/confidential-projects\"" >> "$HOME/.bashrc"
  # ~/.local/sbin holds the case-guard wrapper and must precede ~/.local/bin,
  # where the real claude launcher lives, for the shadowing to work.
  echo "export PATH=\"\$HOME/.local/sbin:\$HOME/.local/bin:\$PATH\"" >> "$HOME/.bashrc"
  echo "    added to ~/.bashrc - run: source ~/.bashrc"
fi

echo "==> git hooks"
# Nothing else installs these. .gitignore keeps documents out of the repo by
# accident; .githooks/pre-commit is what stops `git add -f` putting one in
# deliberately, and it never runs unless core.hooksPath points at it -- a
# global core.hooksPath (this workspace sets one) shadows .git/hooks
# entirely. .githooks/pre-commit chains back to the global hook itself.
if ! command -v git >/dev/null; then
  echo "    git not installed - skipping"
elif [[ -d "$KIT/.git" ]]; then
  git -C "$KIT" config core.hooksPath .githooks
  echo "    core.hooksPath=.githooks - the document blocker is active"
else
  echo "    $KIT is not a git repository yet. If you version the kit, run:"
  echo "      git -C \"$KIT\" config core.hooksPath .githooks"
  echo "    Until then a client document can be committed with git add -f."
fi

echo
echo "Done. Next:"
echo "  1. tr-model              pull and register gams3:q8 (~13 GB)"
echo "  2. case-init 40G         create the encrypted container"
echo "  3. mkdir -p ~/.local/sbin && cp bin/case-guard ~/.local/sbin/claude"
echo "     chmod +x ~/.local/sbin/claude            (the Claude Code guard)"
echo "     NOT over ~/.local/bin/claude - that is the real launcher"
echo "  4. case-open"
echo "  5. tr-project --new <name>"
echo "  6. copy the client drop into the project's source/ (keep its folders)"
echo "  7. tr-inventory           classify every file by source language"
echo "  8. tr-status / tr-run     operate on the matching files only"
