#!/usr/bin/env bash
# case-close - unmount and lock the encrypted case container.
#
# Usage:  case-close [-f]
#
# Reports which processes still hold files open rather than failing with a
# bare "target is busy". A long batch run is the usual culprit.

set -uo pipefail
MAP="${CASE_MAP:-casedata}"
MNT="${CASE_MNT:-$HOME/translation-work/confidential-projects}"
# Defined here because the closing message names the container file. It was
# not, and under `set -u` that made case-close exit non-zero on its last two
# lines -- after a successful unmount, so the container was safely closed but
# the script that had just been reworded to reassure ended in an error.
IMG="${CASE_IMG:-$HOME/.case/confidential.luks}"
FORCE=0; [[ "${1:-}" == "-f" ]] && FORCE=1

if ! mountpoint -q "$MNT"; then
  echo "not mounted; nothing to do"
  # still make sure the mapping is gone
  sudo cryptsetup luksClose "$MAP" 2>/dev/null || true
  exit 0
fi

busy="$(sudo lsof +D "$MNT" 2>/dev/null | tail -n +2)"
if [[ -n "$busy" ]]; then
  echo "Files are still open under $MNT:"
  echo "$busy" | awk '{printf "  %-14s pid %-8s %s\n", $1, $2, $9}' | sort -u | head -20
  echo
  if [[ $FORCE -eq 0 ]]; then
    echo "Finish or stop those processes, then run case-close again."
    echo "To unmount anyway (risks data loss in a running batch): case-close -f"
    exit 1
  fi
  echo "-f given: unmounting anyway."
fi

sync
sudo umount "$MNT" || { echo "umount failed" >&2; exit 1; }
sudo cryptsetup luksClose "$MAP"

# Re-arm the immutable mountpoint so nothing writes to the bare directory.
sudo chattr +i "$MNT" 2>/dev/null || \
  echo "  note: could not set immutable flag on $MNT (filesystem may not support it)"

# The old wording was "$MNT is now empty and locked", which reads as though
# the work had been thrown away. It had not: closing unmounts a filesystem,
# it does not delete one. The mountpoint looks empty because nothing is
# mounted there any more, and everything written during the session is inside
# the container file, encrypted. Saying where the work went costs two lines
# and stops the operator wondering whether they have just lost a day.
used="$(du -h "$IMG" 2>/dev/null | cut -f1)"
cat <<EOF
closed and encrypted.

  Your work is safe. It lives inside the container file, not at the
  mountpoint:

    $IMG   (${used:-?} on disk)

  $MNT looks empty because nothing is mounted
  there now. Run case-open and it is all back, exactly as you left it.
  Nothing is deleted by closing -- unmounting a filesystem does not remove
  what is in it.

  Safe to start Claude Code.
EOF
