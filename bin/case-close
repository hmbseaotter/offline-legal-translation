#!/usr/bin/env bash
# case-close - unmount and lock the encrypted case container.
#
# Usage:  case-close [-f]
#
# Reports which processes still hold files open rather than failing with a
# bare "target is busy". A long batch run is the usual culprit.

set -uo pipefail
MAP="${CASE_MAP:-casedata}"
MNT="${CASE_MNT:-$HOME/translation-work/confidential-projects}"
# Defined here because the closing message names the container file. It was
# not, and under `set -u` that made case-close exit non-zero on its last two
# lines -- after a successful unmount, so the container was safely closed but
# the script that had just been reworded to reassure ended in an error.
IMG="${CASE_IMG:-$HOME/.case/confidential.luks}"
FORCE=0; [[ "${1:-}" == "-f" ]] && FORCE=1

if ! mountpoint -q "$MNT"; then
  echo "not mounted; nothing to do"
  # still make sure the mapping is gone
  sudo cryptsetup luksClose "$MAP" 2>/dev/null || true
  exit 0
fi

# Everything this script spawns -- the sudo, the lsof, the subshells -- runs
# in its own process group, and every one of them inherits the caller's
# working directory. Run from inside the container, case-close therefore
# reported ITSELF as the reason it could not close: eight entries, of which
# two were the lsof doing the reporting. The check could never pass.
MYPG="$(ps -o pgid= -p $$ 2>/dev/null | tr -d ' ')"
raw="$(sudo lsof +D "$MNT" 2>/dev/null | tail -n +2)"
busy="$(printf '%s\n' "$raw" | awk -v pg="$MYPG" '
  NF >= 9 {
    cmd = "ps -o pgid= -p " $2 " 2>/dev/null"
    cmd | getline theirs; close(cmd)
    gsub(/ /, "", theirs)
    if (theirs != pg) print
  }')"

# A process merely sitting in the directory is a different problem from one
# writing to it, and it has a different fix: cd out. lsof marks the first
# with FD "cwd". Telling an operator to "finish or stop those processes"
# when the process is their own login shell, and the remedy is one cd, is
# advice that cannot be followed.
cwd_only="$(printf '%s\n' "$busy" | awk 'NF>=9 && $4 != "cwd"' )"

if [[ -n "${busy//[[:space:]]/}" ]]; then
  if [[ -z "${cwd_only//[[:space:]]/}" ]]; then
    echo "Nothing is writing to $MNT, but something is sitting in it:"
    printf '%s\n' "$busy" | awk '{printf "  %-12s pid %-8s cwd %s\n", $1, $2, $9}' \
      | sort -u | head -20
    echo
    echo "A shell whose working directory is inside the container keeps it"
    echo "busy. Leave the directory and close again -- no force needed:"
    echo
    echo "    cd ~ && case-close"
    echo
    [[ $FORCE -eq 0 ]] && exit 1
  else
    echo "Files are still open under $MNT:"
    printf '%s\n' "$cwd_only" | awk '{printf "  %-12s pid %-8s %s\n", $1, $2, $9}' \
      | sort -u | head -20
    echo
    if [[ $FORCE -eq 0 ]]; then
      echo "Finish or stop those processes, then run case-close again."
      echo "To unmount anyway (risks data loss in a running batch): case-close -f"
      exit 1
    fi
  fi
  [[ $FORCE -eq 1 ]] && echo "-f given: unmounting anyway."
fi

sync
if ! sudo umount "$MNT"; then
  {
    echo
    echo "umount failed: something still has $MNT open."
    echo
    echo "The usual cause is a shell sitting in the directory -- including"
    echo "the one you are typing in. It does not show as an open file, and"
    echo "-f does not help, because the kernel counts a working directory as"
    echo "a use of the filesystem just as much as an open file."
    echo
    echo "    cd ~ && case-close"
    echo
    echo "If that is not it, find the holder with:"
    echo "    sudo lsof +D $MNT"
  } >&2
  exit 1
fi
sudo cryptsetup luksClose "$MAP"

# Re-arm the immutable mountpoint so nothing writes to the bare directory.
sudo chattr +i "$MNT" 2>/dev/null || \
  echo "  note: could not set immutable flag on $MNT (filesystem may not support it)"

# The old wording was "$MNT is now empty and locked", which reads as though
# the work had been thrown away. It had not: closing unmounts a filesystem,
# it does not delete one. The mountpoint looks empty because nothing is
# mounted there any more, and everything written during the session is inside
# the container file, encrypted. Saying where the work went costs two lines
# and stops the operator wondering whether they have just lost a day.
used="$(du -h "$IMG" 2>/dev/null | cut -f1)"
cat <<EOF
closed and encrypted.

  Your work is safe. It lives inside the container file, not at the
  mountpoint:

    $IMG   (${used:-?} on disk)

  $MNT looks empty because nothing is mounted
  there now. Run case-open and it is all back, exactly as you left it.
  Nothing is deleted by closing -- unmounting a filesystem does not remove
  what is in it.

  Safe to start Claude Code.
EOF
