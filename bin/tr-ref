#!/usr/bin/env python3
"""tr-ref - line up reference translations so their sentences are reused.

OPERATOR ONLY, container open. Reads client documents and prints their names.

Usage:  tr-ref [--rebuild] [--conflicts]

  --rebuild    align every pair again, not only the ones that changed
  --conflicts  print every sentence the draft will carry as REF_OPTIONS, each
               rendering with its document count and the date that ordered it

PUT THE FILES HERE, inside the project, anywhere under reference/:

    reference/leases/lease-2023_English.docx
    reference/leases/lease-2023_German.pdf

Both files of a pair in the same folder, named alike apart from a language
suffix: _English, _German, _Slovene, or _EN, _DE, _SL, in any case. Either
side may be Word, PDF with a text layer, scanned PDF or plain text; tr-pdf
makes the text of a PDF, OCR'ing a scan in the language of its file. The
suffix names a language, not a role, so a pair serves both directions.

German takes a variant after a hyphen: _German-CH, _German-AT, and _German
or _German-DE for Germany. An original beside a Germany and a Swiss
translation makes two pairs. A German translation is reused only where
TR_TGT is its variant; one in another variant is never reused, and is
offered as an option only where the project's own variant has no reference
for the sentence.

WHAT IT WRITES, inside the project:

  work/reference.sqlite         the kept sentence pairs, which tr-run reuses
  work/reference/pairs.tsv      the same, to read: document, source, target,
                                how, and reused -- yes, option or no
  work/reference/rejected.tsv   the pairs not kept, and why

Read pairs.tsv before the first tr-run. Every line marked yes or option can
go into a deliverable word for word, and an alignment tool that is right
almost always is still wrong somewhere.

WHAT HAPPENS NEXT

  tr-run                a source sentence identical to a kept reference
                        sentence takes that translation, with no model call.
                        Where the references disagree -- or the only
                        rendering was read by OCR, or is in another German
                        variant -- the draft carries the choice instead:
                            REF_OPTIONS «…» | «…»
                        Search the deliverables for REF_OPTIONS, keep one
                        rendering and delete the rest
  tr-terms --reference  proposes glossary entries from the references rather
                        than from the model's drafts

Segments taken from a reference never enter the translation memory, options
included, so tr-lint does not check them: they are the translator's own work.
How options are ordered, and why the draft carries two, is in lib/trref.py.
"""
import argparse
import collections
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                "..", "lib"))
import trlib  # noqa: E402
import trref  # noqa: E402


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--rebuild", action="store_true",
                    help="align every pair again, not only the ones that changed")
    ap.add_argument("--conflicts", action="store_true",
                    help="print every sentence written as REF_OPTIONS, each "
                         "rendering with its document count and the date that "
                         "ordered it")
    a = ap.parse_args()

    src_lang, tgt_lang = trlib.project_pair()
    tgt_base = trlib.base_lang(tgt_lang)
    # Stored per language pair, reused per variant: a Swiss pair is filed
    # under en-de beside Germany's and reused under en-de-CH. See
    # trref.reuse_direction().
    direction = f"{src_lang}-{tgt_base}"
    reuse_as = f"{src_lang}-{tgt_lang}"
    if src_lang == tgt_base:
        sys.exit(f"TR_SRC and TR_TGT are both {src_lang} - set the pair in "
                 f"project.conf first")
    root = trlib.path("reference")
    if not os.path.isdir(root):
        print(f"  no reference translations in this project.\n\n"
              f"  To use some, put each pair in the same folder under\n"
              f"      {root}/\n"
              f"  named alike apart from a language suffix:\n"
              f"      lease-2023_English.docx   lease-2023_German.pdf\n"
              f"  then run tr-ref again.")
        return 0

    pairs, unpaired, ambiguous, unlabelled, other = \
        trref.find_pairs(src_lang, tgt_lang)
    db = trref.open_store()
    known = {doc: sig for doc, sig in db.execute(
        "SELECT doc, signature FROM docs WHERE direction = ?", (direction,))}

    # A document removed from reference/ takes its sentences with it.
    present = {doc for doc, _s, _t, _v in pairs}
    gone = [doc for doc in known if doc not in present]
    for doc in gone:
        db.execute("DELETE FROM pairs WHERE direction = ? AND doc = ?", (direction, doc))
        db.execute("DELETE FROM docs WHERE direction = ? AND doc = ?", (direction, doc))
    db.commit()

    print(f"  {len(pairs)} reference pair(s), {reuse_as}\n")
    rejected_all = []
    for doc, sp, tp, variant in pairs:
        # A pair in another variant is aligned and kept like any other, and
        # says on its line that this project never reuses it.
        elsewhere = trref.reuse_direction(direction, variant)
        vnote = "" if elsewhere == reuse_as else \
            f"   ({elsewhere}: never reused in {reuse_as}, at most offered)"
        sig = trref.signature(sp, tp)
        # Read on every run, not only when a pair is aligned: the date orders
        # renderings, and a document unchanged since before dates has none.
        date, date_from = trref.file_date(tp)
        if not a.rebuild and known.get(doc) == sig:
            kept, why = db.execute(
                "SELECT kept, rejected FROM docs WHERE direction = ? AND doc = ?",
                (direction, doc)).fetchone()
            db.execute("UPDATE docs SET date = ?, date_from = ? "
                       "WHERE direction = ? AND doc = ?",
                       (date, date_from, direction, doc))
            print(f"  unchanged  kept {kept:>5}   {doc}{vnote}")
            continue
        try:
            sparas, show = trref.paragraphs(sp, src_lang)
            tparas, thow = trref.paragraphs(tp, tgt_base)
        except Exception as e:
            print(f"  FAILED     {doc}: {type(e).__name__}: {e}")
            continue
        paragraphs = show in ("docx", "txt") and thow in ("docx", "txt")
        kept, rejected = trref.align_document(sparas, tparas,
                                              by_paragraph=paragraphs)
        how = show if show == thow else f"{show}/{thow}"
        reusable = int("pdf-ocr" not in (show, thow))
        db.execute("DELETE FROM pairs WHERE direction = ? AND doc = ?", (direction, doc))
        db.executemany(
            "INSERT INTO pairs (direction, doc, src, src_norm, tgt, how, reusable,"
            " variant) VALUES (?,?,?,?,?,?,?,?)",
            [(direction, doc, s, trref.norm(s), t, how, reusable, variant)
             for s, t in kept])
        reasons = collections.Counter(r for _s, _t, r in rejected)
        summary = ", ".join(f"{r} {n}" for r, n in reasons.most_common())
        db.execute("INSERT OR REPLACE INTO docs (direction, doc, signature, kept, "
                   "rejected, date, date_from) VALUES (?,?,?,?,?,?,?)",
                   (direction, doc, sig, len(kept), summary, date, date_from))
        db.commit()
        rejected_all.extend((doc, s, t, r) for s, t, r in rejected)
        note = "" if reusable else "   (OCR: offered, never reused)"
        print(f"  aligned    kept {len(kept):>5}   rejected {len(rejected):>4}"
              f"   {doc}  [{how}]{note}{vnote}")
        if summary:
            print(f"             not kept: {summary}")
    db.commit()

    if unpaired:
        print(f"\n  {len(unpaired)} file(s) with no counterpart on the other side:")
        for p in unpaired:
            print(f"      {os.path.relpath(p, root)}")
    if ambiguous:
        print(f"\n  {len(ambiguous)} name(s) with two files in one language, "
              f"skipped:")
        for stem in ambiguous:
            print(f"      {stem}")
    if unlabelled:
        print(f"\n  {len(unlabelled)} file(s) with no language suffix, skipped "
              f"- name them ..._English, ..._German, ..._German-CH:")
        for p in unlabelled:
            print(f"      {os.path.relpath(p, root)}")
    if other:
        print(f"\n  {len(other)} file(s) in a language outside {direction}, "
              f"not used:")
        for p in other:
            print(f"      {os.path.relpath(p, root)}")

    # What tr-run will write for each sentence, worked out the way it will:
    # from the same store, with the same glossary.
    gloss = trlib.load_glossary()
    resolved = {sn: trref.resolve(rs, reuse_as, sn, gloss) for sn, rs
                in trref.load_references().get(direction, {}).items()}
    options = sorted(sn for sn, (text, _shown, _ranked) in resolved.items()
                     if text.startswith(trref.OPTIONS_MARK))

    rows = list(trref.kept(db, reuse_as))
    outdir = trlib.path("work", "reference")
    os.makedirs(outdir, exist_ok=True)
    with open(os.path.join(outdir, "pairs.tsv"), "w", encoding="utf-8") as fh:
        fh.write("document\tsource\ttarget\thow\treused\n")
        for _d, doc, s, sn, t, how, _reusable in rows:
            # Whether this line's own words reach a draft. No for another
            # spelling of the rendering kept, a rendering past the first two,
            # or another variant where the project's own has the sentence.
            text, shown, _ranked = resolved[sn]
            reused = "no"
            if trref.norm(t) in {g.text for g in shown}:
                reused = "option" if text.startswith(trref.OPTIONS_MARK) else "yes"
            fh.write("\t".join(x.replace("\t", " ") for x in
                               (doc, s, t, how, reused)) + "\n")
    if rejected_all or a.rebuild:
        with open(os.path.join(outdir, "rejected.tsv"), "w", encoding="utf-8") as fh:
            fh.write("document\tsource\ttarget\treason\n")
            for doc, s, t, r in rejected_all:
                fh.write("\t".join(x.replace("\t", " ") for x in (doc, s, t, r)) + "\n")

    db.close()
    print(f"\n  {len(rows)} sentence pair(s) kept; {len(resolved) - len(options)} "
          f"distinct source sentence(s) will be reused by tr-run")
    if options:
        print(f"  {len(options)} source sentence(s) will be written as "
              f"{trref.OPTIONS_MARK} for the translator to choose")
        if a.conflicts:
            for sn in options:
                _text, shown, ranked = resolved[sn]
                print(f"\n    {sn}")
                for g in ranked:
                    tags = f" ({', '.join(g.tags)})" if g.tags else ""
                    when = (f"newest {g.date[:10]}, {g.date_from}, {g.date_doc}"
                            if g.date else "no date")
                    print(f"    {'*' if g in shown else ' '} «{g.text}»{tags}\n"
                          f"        {len(g.docs)} document(s); {when}")
            print("\n  * written into the draft; the rest are listed here only")
        else:
            print("  see them:  tr-ref --conflicts")
    print(f"\n  read before tr-run:  {os.path.join(outdir, 'pairs.tsv')}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
