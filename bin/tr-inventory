#!/usr/bin/env python3
"""tr-inventory - inventory every file in source/ and detect its language.

Usage:  tr-inventory [--rescan] [--no-ocr] [--limit N]
        tr-inventory --count [--with-ocr]

--count reads every file in full instead of sampling, and reports words and
segments per file so the volume of work can be judged before any of it
starts. Two units, because there are two questions: the translator is quoted
in words, while machine time is governed by segments -- and only the ones the
memory has not already seen, which on a table-heavy drop is a fraction of
them. Words alone would answer neither question honestly.

Scanned PDFs are the expensive part, so --count does not OCR them: it counts
what has a text layer, reuses anything tr-pdf has already OCR'd, and lists
the rest with a page count. --with-ocr runs the real pass and caches it where
tr-pdf will find it, so the work is done once.

Client drops arrive as nested folder trees mixing Slovene with English,
Croatian/Serbian, Armenian and whatever else. This walks source/ in full,
records every file whether or not the pipeline can translate it, and decides
which language each one is in. Only the Slovene files go on to tr-run.

WHERE THE OUTPUT GOES, and why it matters:

  work/inventory/manifest.tsv    every file, with its path -- STAYS INSIDE
  work/inventory/by-lang/*.txt   paths grouped by language -- STAYS INSIDE
  work/inventory/summary.txt     counts only -- this is the client report

File paths in a criminal matter routinely carry party names, dates and case
numbers, so the first two are case material and never leave the container.
summary.txt holds no paths, which is what makes it safe to send.

Resumable: a file already in the manifest with the same size and mtime is not
re-examined. --rescan forces a fresh look at everything.

OPERATOR ONLY. This reads every client document. Run it in a plain terminal,
never with an assistant attached.
"""
import os, sys, csv, subprocess, argparse, tempfile, shutil
from collections import Counter

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "lib"))
import trlib
import trlang

SAMPLE_WORDS = 400          # enough to decide; no reason to read whole files

# Measured on this machine with gams3:q8 over 12 samples of real pipeline
# traffic. Duplicated from bin/tr-xlsx deliberately -- it is a measurement,
# and if it is re-measured both must move together.
SEC_PER_SEGMENT = 48.3
OCR_SAMPLE_LANGS = os.environ.get("TR_OCR_SAMPLE_LANGS", "slv+hrv+eng")

TEXT_EXT  = {".txt", ".md", ".csv", ".tsv", ".log"}
# Formats with no text extractor here. Counted and reported, never guessed at.
OPAQUE_EXT = {".doc", ".odt", ".rtf", ".ods", ".ppt", ".pptx", ".odp",
              ".jpg", ".jpeg", ".png", ".tif", ".tiff", ".gif", ".bmp",
              ".zip", ".rar", ".7z", ".msg", ".eml", ".mp3", ".mp4", ".wav"}


def _cap(words, limit):
    """limit None means take everything -- counting, rather than sampling."""
    return " ".join(words if limit is None else words[:limit])


def _enough(out, limit):
    return limit is not None and len(out) >= limit


def from_docx(path, limit=SAMPLE_WORDS):
    import docx
    d = docx.Document(path)
    out = []
    for p in d.paragraphs:
        if p.text.strip():
            out.extend(p.text.split())
        if _enough(out, limit):
            return _cap(out, limit), "docx"
    for t in d.tables:
        for r in t.rows:
            for c in r.cells:
                if c.text.strip():
                    out.extend(c.text.split())
            if _enough(out, limit):
                return _cap(out, limit), "docx"
    return _cap(out, limit), "docx"


def from_xlsx(path, limit=SAMPLE_WORDS):
    import openpyxl
    wb = openpyxl.load_workbook(path, read_only=True, data_only=True)
    out = []
    for ws in wb.worksheets:
        for row in ws.iter_rows(values_only=True):
            for v in row:
                if isinstance(v, str) and v.strip():
                    out.extend(v.split())
            if _enough(out, limit):
                wb.close()
                return _cap(out, limit), "xlsx"
    wb.close()
    return _cap(out, limit), "xlsx"


def from_text(path, limit=SAMPLE_WORDS):
    with open(path, encoding="utf-8", errors="replace") as fh:
        raw = fh.read() if limit is None else fh.read(200_000)
    return _cap(raw.split(), limit), "text"


def _ocr_key(path):
    """tr-pdf's cache key for this file: the path under source/, flattened.

    Not the basename. Two exhibits called zapisnik.pdf in different drops
    would have shared one entry, and the second would have been translated
    from the first one's text layer with nothing in the output to show it.
    Drops arrive nested and filenames are preserved by design, so duplicate
    names across drops are expected rather than unlucky. tr-pdf builds the
    same key; the two must agree or the cache is never hit.
    """
    root = trlib.ROOT
    if not root:
        return None
    src = os.path.join(root, "source") + os.sep
    full = os.path.abspath(path)
    if not full.startswith(src):
        return None
    return os.path.splitext(full[len(src):])[0].replace(os.sep, "__")


def _ocr_cache(path):
    """The cached OCR text layer for this file, if tr-pdf has made one."""
    try:
        key = _ocr_key(path)
        if not key:
            return None
        cached = os.path.join(trlib.ROOT, "work", "ocr", key + ".txt")
        return cached if os.path.exists(cached) else None
    except Exception:
        return None


def _pdf_pages(path):
    try:
        r = subprocess.run(["pdfinfo", path], capture_output=True, timeout=60)
        for ln in r.stdout.decode("utf-8", "replace").splitlines():
            if ln.startswith("Pages:"):
                return int(ln.split()[1])
    except Exception:
        pass
    return 0


def from_pdf(path, allow_ocr=True, limit=SAMPLE_WORDS, full_ocr=False):
    """Text layer if there is one; otherwise OCR.

    A scanned PDF has no text to detect a language from, and ocrmypdf needs
    to be told a language before it can make any. Sampling two pages with a
    combined language set breaks that circle: detect from the sample, then
    the real OCR pass can be told the right language instead of guessing.

    Counting is a different job from detecting. It needs the whole document,
    so it reads every page rather than the first five, and prefers the OCR
    text layer tr-pdf has already cached. Where no cache exists and the file
    is scanned, it reports pdf-needs-ocr with a page count rather than
    quietly returning a count based on nothing -- unless full_ocr was asked
    for, in which case it runs the real pass and caches it for tr-pdf.
    """
    cached = _ocr_cache(path) if limit is None else None
    if cached:
        with open(cached, encoding="utf-8", errors="replace") as fh:
            return _cap(fh.read().split(), limit), "pdf-ocr-cached"

    args = ["pdftotext", "-layout", path, "-"]
    if limit is not None:
        args[1:1] = ["-l", "5"]
    try:
        r = subprocess.run(args, capture_output=True, timeout=300)
        words = r.stdout.decode("utf-8", "replace").split()
    except Exception:
        words = []
    if len(words) >= trlang.MIN_TOKENS:
        return _cap(words, limit), "pdf-text"

    if limit is None and not full_ocr:
        return "", f"pdf-needs-ocr ({_pdf_pages(path)} pages)"
    if limit is None and full_ocr:
        return _full_ocr(path, limit)
    if not allow_ocr:
        return "", "pdf-needs-ocr"
    if not (shutil.which("pdftoppm") and shutil.which("tesseract")):
        return "", "pdf-needs-ocr"
    tmp = tempfile.mkdtemp(prefix="trinv-")
    try:
        subprocess.run(["pdftoppm", "-jpeg", "-r", "150", "-f", "1", "-l", "2",
                        path, os.path.join(tmp, "pg")],
                       capture_output=True, timeout=180)
        got = []
        for img in sorted(os.listdir(tmp)):
            r = subprocess.run(
                ["tesseract", os.path.join(tmp, img), "stdout",
                 "-l", OCR_SAMPLE_LANGS],
                capture_output=True, timeout=180)
            got.extend(r.stdout.decode("utf-8", "replace").split())
            if _enough(got, SAMPLE_WORDS):
                break
        return _cap(got, limit), "pdf-ocr-sample"
    except Exception:
        return "", "pdf-needs-ocr"
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def _full_ocr(path, limit):
    """Real OCR pass, cached where tr-pdf will find it."""
    root = trlib.ROOT
    if not root or not shutil.which("ocrmypdf"):
        return "", "pdf-needs-ocr (ocrmypdf missing)"
    ocrdir = os.path.join(root, "work", "ocr")
    os.makedirs(ocrdir, exist_ok=True)
    key = _ocr_key(path) or os.path.splitext(os.path.basename(path))[0]
    out_pdf = os.path.join(ocrdir, key + ".ocr.pdf")
    out_txt = os.path.join(ocrdir, key + ".txt")
    langs = os.environ.get("TR_OCR_LANGS", "slv+eng")
    try:
        if not os.path.exists(out_pdf):
            subprocess.run(["ocrmypdf", "-l", langs, "--rotate-pages",
                            "--deskew", "--clean", "--output-type", "pdfa",
                            "--quiet", path, out_pdf],
                           capture_output=True, timeout=3600, check=True)
        subprocess.run(["pdftotext", "-layout", out_pdf, out_txt],
                       capture_output=True, timeout=300, check=True)
        with open(out_txt, encoding="utf-8", errors="replace") as fh:
            return _cap(fh.read().split(), limit), "pdf-ocr-full"
    except Exception as e:
        return "", f"pdf-ocr-failed: {type(e).__name__}"


def extract(path, ext, allow_ocr, limit=SAMPLE_WORDS, full_ocr=False):
    try:
        if ext == ".docx":
            return from_docx(path, limit)
        if ext == ".xlsx":
            return from_xlsx(path, limit)
        if ext in TEXT_EXT:
            return from_text(path, limit)
        if ext == ".pdf":
            return from_pdf(path, allow_ocr, limit, full_ocr)
        if ext in OPAQUE_EXT:
            return "", "no-extractor"
    except Exception as e:
        return "", f"error: {type(e).__name__}"
    return "", "no-extractor"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--rescan", action="store_true",
                    help="re-examine files already in the manifest")
    ap.add_argument("--no-ocr", action="store_true",
                    help="do not sample-OCR scanned PDFs; mark them instead")
    ap.add_argument("--limit", type=int, default=0)
    ap.add_argument("--count", action="store_true",
                    help="read every file in full and count words and "
                         "segments, for estimating the volume of work")
    ap.add_argument("--with-ocr", action="store_true",
                    help="with --count, run the real OCR pass on scanned PDFs "
                         "instead of listing them as needing it. Slow, and "
                         "cached so tr-pdf does not repeat it")
    a = ap.parse_args()
    if a.with_ocr and not a.count:
        ap.error("--with-ocr only means anything with --count")
    limit = None if a.count else SAMPLE_WORDS

    # Resolve the project first: "the container is not mounted" must be the
    # message you get when the container is not mounted, not a complaint
    # about dictionaries.
    src = trlib.path("source")
    if not os.path.isdir(src):
        sys.exit(f"no source directory: {src}")

    det = trlang.detector()
    if not det.ready():
        sys.exit("\n" + det.why_not_ready() + "\n")
    outdir = trlib.path("work", "inventory")
    os.makedirs(os.path.join(outdir, "by-lang"), exist_ok=True)
    manifest = os.path.join(outdir, "manifest.tsv")

    prior = {}
    if os.path.exists(manifest) and not a.rescan:
        with open(manifest, encoding="utf-8") as fh:
            for row in csv.DictReader(fh, delimiter="\t"):
                prior[row["path"]] = row

    files = []
    for dp, _, fns in os.walk(src):
        for fn in sorted(fns):
            if fn.startswith(("~$", ".")):
                continue
            files.append(os.path.relpath(os.path.join(dp, fn), src))
    files.sort()
    # --limit caps the work, never the record. Writing the manifest from a
    # limited run used to delete every entry outside the slice: resume state
    # went with it, and summary.txt -- the file sent to the client -- then
    # reported a fraction of the drop with nothing to say it was partial.
    deferred = []
    if a.limit:
        files, deferred = files[:a.limit], files[a.limit:]

    rows, reused = [], 0
    for i, rel in enumerate(files, 1):
        full = os.path.join(src, rel)
        st = os.stat(full)
        old = prior.get(rel)
        # A deferred row matches on size and mtime like any other, so without
        # this it would be "reused" forever and never actually examined.
        # A row counted earlier is reusable; one that was only sampled is not,
        # when counting is what was asked for.
        counted = old.get("words", "") not in ("", "-") if old else False
        if old and old.get("method") != "not-yet-examined" \
                and old.get("bytes") == str(st.st_size) \
                and old.get("mtime") == f"{st.st_mtime:.0f}" \
                and (counted or not a.count):
            rows.append(old); reused += 1
        else:
            ext = os.path.splitext(rel)[1].lower()
            text, method = extract(full, ext, allow_ocr=not a.no_ocr,
                                   limit=limit, full_ocr=a.with_ocr)
            if text:
                lang, conf, note = det.detect(text)
            else:
                lang, conf, note = "unknown", 0.0, method
            row = {"path": rel, "ext": ext, "bytes": str(st.st_size),
                   "mtime": f"{st.st_mtime:.0f}", "lang": lang,
                   "confidence": f"{conf:.2f}", "method": method,
                   "note": note, "words": "-", "segments": "-"}
            if a.count and text:
                row["words"] = str(len(text.split()))
                row["segments"] = str(len(trlib.segment(text)))
                if ext in (".xlsx", ".csv", ".tsv"):
                    # A spreadsheet has cells, not prose. Counting its words
                    # invites a quote based on a number that means nothing;
                    # what governs the work there is unique strings, which
                    # tr-xlsx --survey reports.
                    row["note"] = (row["note"] + "; " if row["note"] else "") + \
                        "tabular - see tr-xlsx --survey for unique strings"
            rows.append(row)
        sys.stderr.write(f"\r  {i}/{len(files)} ")
        sys.stderr.flush()
    sys.stderr.write("\n")

    # Carry forward everything the limit deferred, so the manifest still
    # describes the whole drop. Files never yet examined are recorded as
    # pending rather than silently omitted -- an absent row and an
    # undetermined row mean different things to whoever reads this next.
    for rel in deferred:
        old = prior.get(rel)
        if old:
            rows.append(old)
            continue
        try:
            st = os.stat(os.path.join(src, rel))
        except OSError:
            continue
        rows.append({"path": rel, "ext": os.path.splitext(rel)[1].lower(),
                     "bytes": str(st.st_size), "mtime": f"{st.st_mtime:.0f}",
                     "lang": "unknown", "confidence": "0.00",
                     "method": "not-yet-examined",
                     "note": "deferred by --limit; re-run without it"})
    rows.sort(key=lambda r: r["path"])

    cols = ["path", "ext", "bytes", "mtime", "lang", "confidence", "method",
            "words", "segments", "note"]
    with open(manifest, "w", encoding="utf-8", newline="") as fh:
        w = csv.DictWriter(fh, fieldnames=cols, delimiter="\t",
                           extrasaction="ignore")
        w.writeheader()
        for r in rows:
            w.writerow(r)

    by = {}
    for r in rows:
        by.setdefault(r["lang"], []).append(r["path"])
    for d in os.listdir(os.path.join(outdir, "by-lang")):
        os.remove(os.path.join(outdir, "by-lang", d))
    for lang, paths in by.items():
        with open(os.path.join(outdir, "by-lang", f"{lang}.txt"), "w",
                  encoding="utf-8") as fh:
            fh.write("\n".join(sorted(paths)) + "\n")

    # "Not examined yet" is not a detection result. Counting deferred files
    # as undetermined would report a confident-looking language breakdown
    # that is really a description of how far the scan got.
    examined = [r for r in rows if r.get("method") != "not-yet-examined"]
    pending = len(rows) - len(examined)
    counts = Counter(r["lang"] for r in examined)
    fmts = Counter(r["ext"] or "(none)" for r in rows)
    lines = []
    lines.append(f"Project:        {trlib.project_name()}")
    lines.append(f"Files inventoried: {len(rows)}")
    if pending:
        lines.append(f"  of which examined: {len(examined)}")
    lines.append("")
    lines.append("By detected source language:")
    for lang, n in counts.most_common():
        mark = "  <- to translate" if lang == trlang.TARGET else ""
        lines.append(f"  {trlang.LABEL.get(lang, lang):<20} {n:>6}{mark}")
    if a.count:
        # Volume, which is two different questions with two different units.
        #
        # The translator is owed words; that is how the work is quoted. The
        # machine is owed segments, and only the ones it has not seen before:
        # the memory collapses repeats, and on the fixture spreadsheet that
        # was 21,006 cells down to 19 distinct strings. Reporting words alone
        # would have predicted days of machine time for seconds of work.
        tgt = [r for r in examined if r["lang"] == trlang.TARGET]
        def total(rs, k):
            return sum(int(r[k]) for r in rs if r.get(k, "-").isdigit())
        words, segs = total(tgt, "words"), total(tgt, "segments")
        needs = [r for r in examined if "needs-ocr" in r.get("method", "")]
        lines.append("")
        lines.append(f"Volume, {trlang.LABEL[trlang.TARGET]} only "
                     f"({len(tgt)} file(s)):")
        lines.append(f"  words                {words:>9,}")
        lines.append(f"  segments             {segs:>9,}")
        if segs:
            secs = segs * SEC_PER_SEGMENT
            if secs < 3600:
                span = f"{secs / 60:,.0f} min"
            elif secs < 86400:
                span = f"{secs / 3600:,.1f} h"
            else:
                span = f"{secs / 3600:,.0f} h  ({secs / 86400:,.1f} days)"
            lines.append(f"  machine time         ~{span}")
            lines.append(f"       at {SEC_PER_SEGMENT:.0f}s/segment, measured, "
                         f"and before the memory collapses repeats")
        allw = total(examined, "words")
        if allw != words:
            lines.append(f"  (all languages       {allw:>9,} words)")
        if needs:
            lines.append("")
            lines.append(f"  {len(needs)} scanned PDF(s) not counted - no text "
                         f"layer. Re-run with --with-ocr to include them.")
            for r in needs[:5]:
                lines.append(f"    {r['method']}")
        lines.append("")
        lines.append("  Word counts from OCR are approximate. Spreadsheets are "
                     "cells rather than")
        lines.append("  prose - use tr-xlsx --survey for the number that "
                     "governs work there.")
    lines.append("")
    lines.append("By file format:")
    for ext, n in fmts.most_common():
        lines.append(f"  {ext:<20} {n:>6}")
    undet = counts.get("unknown", 0)
    if undet:
        lines.append("")
        lines.append(f"{undet} file(s) undetermined - listed in "
                     f"by-lang/unknown.txt for manual review.")
    if pending:
        lines.append("")
        lines.append(f"INCOMPLETE: {pending} file(s) not yet examined "
                     f"(--limit was used). Re-run tr-inventory without "
                     f"--limit before sending this summary anywhere.")
    summary = "\n".join(lines) + "\n"

    with open(os.path.join(outdir, "summary.txt"), "w", encoding="utf-8") as fh:
        fh.write(summary)

    print(summary)
    if reused:
        print(f"({reused} unchanged file(s) reused from the previous scan; "
              f"--rescan to redo)")
    print(f"manifest:  {manifest}       <- contains paths, keep inside the container")
    print(f"summary:   {os.path.join(outdir, 'summary.txt')}   <- counts only, safe to send")


if __name__ == "__main__":
    main()
