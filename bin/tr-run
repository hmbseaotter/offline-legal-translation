#!/usr/bin/env bash
# tr-run - translate everything in source/ that is not yet in translated/.
#
# Resumable: skips files already present in translated/, and within a file
# every segment already in the translation memory is reused rather than
# regenerated. Killing this mid-run and restarting loses at most one segment.
#
# Usage:  tr-run                 # translate what tr-inventory found in TR_SRC
#         tr-run -n              # dry run: list what would be done
#         tr-run --all           # ignore the inventory, translate everything
#         tr-run path/to/one.docx
#
# -n and --all may be given in either order, and combine.

set -uo pipefail
BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$BIN/../lib/guard.sh"
tr_guard_resolve_root \
  "Writing there now would put case material outside the encryption."
PROJECT="$(basename "$TR_ROOT")"

# Per-project settings (language pair, suffix, OCR languages).
#
# Parsed rather than sourced. project.conf is data, and sourcing it both
# executes whatever it contains and clobbers the environment -- so
# `TR_SUFFIX=x tr-run` was silently overridden by the file. An explicit
# environment setting is a deliberate one-off and now wins. lib/trlib.py
# reads the same file the same way, so the tools invoked directly agree.
load_conf() {
  local f="$1" line k v
  [[ -f "$f" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    [[ "$line" == *=* ]] || continue
    k="${line%%=*}"; v="${line#*=}"
    read -r k <<< "$k" || true                 # trims surrounding whitespace
    read -r v <<< "$v" || true
    [[ "$k" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
    v="${v%\"}"; v="${v#\"}"; v="${v%\'}"; v="${v#\'}"
    [[ -n "${!k+set}" ]] || export "$k=$v"
  done < "$f"
}
load_conf "$TR_ROOT/project.conf"

SRC="$TR_ROOT/source"
OUT="$TR_ROOT/translated"
LOG="$TR_ROOT/logs/run-$(date +%Y%m%d-%H%M%S).log"
SUFFIX="${TR_SUFFIX:-}"
mkdir -p "$OUT" "$TR_ROOT/logs" "$TR_ROOT/work"

# Flags in any order. Parsing -n here and --all a hundred lines further down
# meant `tr-run --all -n` consumed --all, then treated -n as a filename and
# died in realpath.
DRY=0; ALL=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    -n)    DRY=1; shift ;;
    --all) ALL=1; shift ;;
    --)    shift; break ;;
    -*)    echo "unknown option: $1" >&2
           echo "usage: tr-run [-n] [--all] [file ...]" >&2; exit 2 ;;
    *)     break ;;
  esac
done

# Deliverable names come from trlib.target_name, not from a second copy of
# the rule.
#
# This used to be out_ext_for() plus target_for(), a bash reimplementation
# of trlib.OUT_EXT, with a comment on both sides warning that the two must
# agree -- because if they drift, tr-run writes one name, tr-status looks
# for another, and every affected file reports as missing for good. That
# warning is the tell: a rule that needs a comment reminding two files to
# stay equal is a rule that lives in the wrong number of places.
#
# Resolved once for the whole batch rather than per file, so this costs one
# interpreter start regardless of corpus size.
# Which model and prompt produced a deliverable.
#
# The staleness test used to be "output newer than source", which is a
# question about editing, not about correctness. TR_PROMPT_VERSION is part
# of the translation memory's key, so bumping it invalidates every cached
# SEGMENT -- but tr-run skipped the whole FILE before the memory was ever
# consulted, so a bump changed nothing and the old drafts stood. The manual
# said "Bump to force retranslation"; it did not.
#
# Found the hard way: the prompt was corrected because the model was
# discarding legible text, the version went to v5, the re-run reported
# "skipped: 3" in three seconds, and the defective drafts were still there.
#
# Read from trlib rather than restated here -- the same rule about one
# implementation that lib/guard.sh and target_name exist for.
read -r MODEL_NOW PROMPT_NOW < <(python3 -c '
import os, sys
sys.path.insert(0, os.path.join("'"$BIN"'", "..", "lib"))
import trlib
print(trlib.MODEL, trlib.PROMPT_VERSION)' 2>/dev/null)
MODEL_NOW="${MODEL_NOW:-unknown}"; PROMPT_NOW="${PROMPT_NOW:-unknown}"
DELIV="$TR_ROOT/work/deliverables.tsv"

deliv_current() {           # 0 when this file was produced by THIS model+prompt
  [[ -f "$DELIV" ]] || return 1
  awk -F'\t' -v r="$1" -v m="$MODEL_NOW" -v v="$PROMPT_NOW" \
      'NR>1 && $1==r && $2==m && $3==v {ok=1} END{exit !ok}' "$DELIV"
}

deliv_record() {
  mkdir -p "$(dirname "$DELIV")"
  [[ -f "$DELIV" ]] || printf 'path\tmodel\tprompt_version\twritten\n' > "$DELIV"
  # Rewritten in place, inside the container. A mktemp here would put file
  # paths -- which carry party names -- on the unencrypted root.
  awk -F'\t' -v r="$1" 'NR==1 || $1!=r' "$DELIV" > "$DELIV.tmp" && mv "$DELIV.tmp" "$DELIV"
  printf '%s\t%s\t%s\t%s\n' "$1" "$MODEL_NOW" "$PROMPT_NOW" "$(date -u +%FT%TZ)" >> "$DELIV"
}

declare -A TARGET
name_batch() {
  local rel
  printf '%s\n' "${FILES[@]}" | TR_SUFFIX="$SUFFIX" python3 -c '
import os, sys
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(sys.argv[1])), "..", "lib"))
import trlib
out = sys.argv[2]
for ln in sys.stdin:
    rel = ln.rstrip("\n")
    if rel:
        print(rel + "\t" + os.path.join(out, trlib.target_name(rel)))
' "$BIN/tr-run" "$OUT"
}

worker_for() {                       # extension -> worker, empty if unsupported
  case "${1,,}" in
    docx) printf '%s' "$BIN/tr-docx" ;;
    xlsx|xlsm|xltx|xltm) printf '%s' "$BIN/tr-xlsx" ;;
    txt)  printf '%s' "$BIN/tr-txt"  ;;
    pdf)  printf '%s' "$BIN/tr-pdf"  ;;
  esac
}

# Which files to work on.
#
# A client drop is not a clean corpus: it mixes Slovene with English,
# Croatian/Serbian and whatever else. Running a Croatian file through an
# sl->en prompt wastes hours of inference AND writes a cached wrong answer
# into work/tm.sqlite that is reused silently from then on. So when
# tr-inventory has classified the tree, translate only the files it found in
# the source language, and say how many were held back.
MANIFEST="$TR_ROOT/work/inventory/manifest.tsv"
HELD=0

# The manifest's column order is not a constant to hardcode. lib/trlib.py
# reads the header by name; doing anything else here would mean the two
# disagree the first time a column is inserted, and awk would silently
# filter on whatever now sits in position 5.
manifest_col() {                     # column name -> 1-based index, empty if absent
  awk -F'\t' -v want="$1" 'NR==1 {
      for (i = 1; i <= NF; i++) if ($i == want) { print i; exit }
    }' "$MANIFEST"
}

if [[ $# -gt 0 ]]; then
  mapfile -t FILES < <(for f in "$@"; do realpath --relative-to="$SRC" "$f"; done)
elif [[ -f "$MANIFEST" && $ALL -eq 0 ]]; then
  want="${TR_SRC:-sl}"
  c_path="$(manifest_col path)"; c_lang="$(manifest_col lang)"
  if [[ -z "$c_path" || -z "$c_lang" ]]; then
    echo "manifest has no 'path'/'lang' header: $MANIFEST" >&2
    echo "re-run: tr-inventory --rescan" >&2
    exit 2
  fi
  mapfile -t FILES < <(awk -F'\t' -v w="$want" -v p="$c_path" -v l="$c_lang" \
                        'NR>1 && $l==w {print $p}' "$MANIFEST" | sort)
  HELD=$(awk -F'\t' -v w="$want" -v l="$c_lang" 'NR>1 && $l!=w' "$MANIFEST" | wc -l)
else
  mapfile -t FILES < <(cd "$SRC" && find . -type f ! -name '~$*' ! -name '.*' \
                        -printf '%P\n' | sort)
fi

cat <<BANNER
========================================================
  PROJECT: $PROJECT
  root:    $TR_ROOT
  pair:    ${TR_SRC:-sl} -> ${TR_TGT:-en}
  files:   ${#FILES[@]}
  log:     $LOG
========================================================
BANNER
if [[ -f "$MANIFEST" && $ALL -eq 0 && $# -eq 0 ]]; then
  echo "  triage: $HELD file(s) held back as not ${TR_SRC:-sl} (tr-inventory)"
elif [[ ! -f "$MANIFEST" && $# -eq 0 ]]; then
  echo "  WARNING: no inventory. EVERY file in source/ will be treated as"
  echo "           ${TR_SRC:-sl}, including any that are not. Run tr-inventory first."
elif [[ $ALL -eq 1 ]]; then
  echo "  --all given: ignoring the inventory, translating everything."
fi
# Writing into the wrong project is the failure mode this layout introduces.
if [[ -t 0 && $DRY -eq 0 && ${#FILES[@]} -gt 0 ]]; then
  read -r -p "Proceed with project '$PROJECT'? [y/N] " ans
  [[ "$ans" == [yY]* ]] || { echo "aborted"; exit 0; }
fi
echo

started=$(date +%s)
done_n=0; skip_n=0; fail_n=0

while IFS=$'\t' read -r _rel _tgt; do
  [[ -n "$_rel" ]] && TARGET["$_rel"]="$_tgt"
done < <(name_batch)

for rel in "${FILES[@]}"; do
  [[ -z "$rel" ]] && continue
  in="$SRC/$rel"
  out="${TARGET[$rel]:-}"
  [[ -n "$out" ]] || { echo "skip   $rel  (no deliverable name)"; ((skip_n++)); continue; }
  ext="${rel##*.}"; ext="${ext,,}"
  worker="$(worker_for "$ext")"

  # Decided before anything is promised, so -n cannot announce work the
  # real run will then refuse to do.
  if [[ -z "$worker" ]]; then
    echo "skip   $rel  (unsupported extension: $ext)"; ((skip_n++)); continue
  fi
  if [[ -f "$out" && "$out" -nt "$in" ]]; then
    if deliv_current "$rel"; then
      echo "skip   $rel"; ((skip_n++)); continue
    fi
    # Up to date against its source, but produced by a different model or a
    # superseded prompt. Say which, because "redo" with no reason reads like
    # the cache failing. Segments the memory still holds are reused, so this
    # is only expensive when the version actually moved.
    was="$(awk -F'\t' -v r="$rel" 'NR>1 && $1==r {print $2" "$3; exit}' "$DELIV" 2>/dev/null)"
    echo "redo   $rel  (${was:-provenance unrecorded} -> $MODEL_NOW $PROMPT_NOW)"
  fi
  if [[ $DRY -eq 1 ]]; then
    echo "would  $rel  ($ext)  ->  ${out#"$OUT"/}"; continue
  fi

  mkdir -p "$(dirname "$out")"
  echo "=== $rel" | tee -a "$LOG"
  t0=$(date +%s)

  "$worker" "$in" "$out" 2>&1 | tee -a "$LOG"

  if [[ ${PIPESTATUS[0]} -eq 0 ]]; then
    deliv_record "$rel"
    ((done_n++)); echo "  done in $(( $(date +%s) - t0 ))s" | tee -a "$LOG"
  else
    ((fail_n++)); echo "  FAILED" | tee -a "$LOG"
  fi
done

echo
echo "translated: $done_n   skipped: $skip_n   failed: $fail_n"
echo "elapsed:    $(( ($(date +%s) - started) / 60 )) min"
echo
echo "next: tr-lint"
