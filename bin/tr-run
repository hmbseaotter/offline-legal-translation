#!/usr/bin/env bash
# tr-run - translate everything in source/ that is not yet in translated/.
#
# Resumable: skips files already present in translated/, and within a file
# every segment already in the translation memory is reused rather than
# regenerated. Killing this mid-run and restarting loses at most one segment.
#
# Usage:  tr-run                 # translate everything missing
#         tr-run -n              # dry run: list what would be done
#         tr-run path/to/one.docx

set -uo pipefail
BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Captured before the default is applied: an explicit TR_PROJECTS is a
# deliberate act (fixtures, a mock-server run, a throwaway root) and lifts
# the mount requirement, exactly as trlib.PROJECTS_OVERRIDDEN does for the
# Python tools. Same rule everywhere or the escape hatch works in one half
# of the kit and not the other.
PROJECTS_OVERRIDDEN=${TR_PROJECTS+y}
TR_PROJECTS="${TR_PROJECTS:-$HOME/translation-work/confidential-projects}"

# Resolve the active project unless TR_ROOT was given explicitly.
# The mountpoint directory exists whether or not the container is open, so
# -d says "the path is there", not "the data is encrypted". Translating a
# corpus onto the bare mountpoint would write every source and target
# sentence out in the clear. mountpoint -q is the test that means it.
if [[ -z "${TR_ROOT:-}" ]]; then
  [[ -n "${PROJECTS_OVERRIDDEN:-}" ]] || mountpoint -q "$TR_PROJECTS" 2>/dev/null || {
    echo "container NOT mounted: $TR_PROJECTS" >&2
    echo "Writing there now would put case material outside the encryption." >&2
    echo "  check:  case-status" >&2
    echo "  open:   case-open" >&2
    echo "  never set up:  case-init 40G" >&2
    exit 2; }
  ACTIVE="$(cat "$TR_PROJECTS/.active" 2>/dev/null | tr -d '[:space:]')"
  [[ -n "$ACTIVE" ]] || { echo "no active project. run: tr-project <name>" >&2; exit 2; }
  TR_ROOT="$TR_PROJECTS/$ACTIVE"
fi
export TR_ROOT TR_PROJECTS
PROJECT="$(basename "$TR_ROOT")"

# Per-project settings (language pair, suffix, OCR languages).
#
# Parsed rather than sourced. project.conf is data, and sourcing it both
# executes whatever it contains and clobbers the environment -- so
# `TR_SUFFIX=x tr-run` was silently overridden by the file. An explicit
# environment setting is a deliberate one-off and now wins. lib/trlib.py
# reads the same file the same way, so the tools invoked directly agree.
load_conf() {
  local f="$1" line k v
  [[ -f "$f" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    [[ "$line" == *=* ]] || continue
    k="${line%%=*}"; v="${line#*=}"
    read -r k <<< "$k" || true                 # trims surrounding whitespace
    read -r v <<< "$v" || true
    [[ "$k" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
    v="${v%\"}"; v="${v#\"}"; v="${v%\'}"; v="${v#\'}"
    [[ -n "${!k+set}" ]] || export "$k=$v"
  done < "$f"
}
load_conf "$TR_ROOT/project.conf"

SRC="$TR_ROOT/source"
OUT="$TR_ROOT/translated"
LOG="$TR_ROOT/logs/run-$(date +%Y%m%d-%H%M%S).log"
SUFFIX="${TR_SUFFIX:-}"
mkdir -p "$OUT" "$TR_ROOT/logs" "$TR_ROOT/work"

DRY=0; [[ "${1:-}" == "-n" ]] && { DRY=1; shift; }

# A scanned PDF cannot be regenerated as a PDF, and plain text has no
# formatting to preserve, so both deliver a .docx. This mirrors OUT_EXT in
# lib/trlib.py, which is what tr-status consults: the two must agree, or
# tr-run writes one name while tr-status looks for another and every
# affected file reports as missing for good.
out_ext_for() {
  case "${1,,}" in
    pdf|txt) printf 'docx' ;;
    *)       printf '%s' "$1" ;;
  esac
}

target_for() {                       # relpath -> absolute output path
  local rel="$1" stem ext
  if [[ "${rel##*/}" == *.* ]]; then
    stem="${rel%.*}"; ext="${rel##*.}"
    printf '%s/%s%s.%s' "$OUT" "$stem" "$SUFFIX" "$(out_ext_for "$ext")"
  else
    printf '%s/%s%s' "$OUT" "$rel" "$SUFFIX"
  fi
}

worker_for() {                       # extension -> worker, empty if unsupported
  case "${1,,}" in
    docx) printf '%s' "$BIN/tr-docx" ;;
    xlsx) printf '%s' "$BIN/tr-xlsx" ;;
    txt)  printf '%s' "$BIN/tr-txt"  ;;
    pdf)  printf '%s' "$BIN/tr-pdf"  ;;
  esac
}

if [[ $# -gt 0 ]]; then
  mapfile -t FILES < <(for f in "$@"; do realpath --relative-to="$SRC" "$f"; done)
else
  mapfile -t FILES < <(cd "$SRC" && find . -type f ! -name '~$*' ! -name '.*' \
                        -printf '%P\n' | sort)
fi

cat <<BANNER
========================================================
  PROJECT: $PROJECT
  root:    $TR_ROOT
  pair:    ${TR_SRC:-sl} -> ${TR_TGT:-en}
  files:   ${#FILES[@]}
  log:     $LOG
========================================================
BANNER
# Writing into the wrong project is the failure mode this layout introduces.
if [[ -t 0 && $DRY -eq 0 && ${#FILES[@]} -gt 0 ]]; then
  read -r -p "Proceed with project '$PROJECT'? [y/N] " ans
  [[ "$ans" == [yY]* ]] || { echo "aborted"; exit 0; }
fi
echo

started=$(date +%s)
done_n=0; skip_n=0; fail_n=0

for rel in "${FILES[@]}"; do
  [[ -z "$rel" ]] && continue
  in="$SRC/$rel"
  out="$(target_for "$rel")"
  ext="${rel##*.}"; ext="${ext,,}"
  worker="$(worker_for "$ext")"

  # Decided before anything is promised, so -n cannot announce work the
  # real run will then refuse to do.
  if [[ -z "$worker" ]]; then
    echo "skip   $rel  (unsupported extension: $ext)"; ((skip_n++)); continue
  fi
  if [[ -f "$out" && "$out" -nt "$in" ]]; then
    echo "skip   $rel"; ((skip_n++)); continue
  fi
  if [[ $DRY -eq 1 ]]; then
    echo "would  $rel  ($ext)  ->  ${out#"$OUT"/}"; continue
  fi

  mkdir -p "$(dirname "$out")"
  echo "=== $rel" | tee -a "$LOG"
  t0=$(date +%s)

  "$worker" "$in" "$out" 2>&1 | tee -a "$LOG"

  if [[ ${PIPESTATUS[0]} -eq 0 ]]; then
    ((done_n++)); echo "  done in $(( $(date +%s) - t0 ))s" | tee -a "$LOG"
  else
    ((fail_n++)); echo "  FAILED" | tee -a "$LOG"
  fi
done

echo
echo "translated: $done_n   skipped: $skip_n   failed: $fail_n"
echo "elapsed:    $(( ($(date +%s) - started) / 60 )) min"
echo
echo "next: tr-lint"
