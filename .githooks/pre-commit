#!/usr/bin/env bash
# pre-commit - keep client material out of the toolkit repository.
#
# Policy: the kit is versioned and may be pushed. Translation projects never
# are -- they are work done for clients. The kit legitimately contains only
# shell scripts, Python, .tsv, .txt and .md, so a staged document or a large
# binary means something from a matter was copied in (usually to debug a
# defect) and is one `git add` away from being published.
#
# .gitignore stops these being picked up by accident; this hook stops them
# being added deliberately with `git add -f`. Belt and braces, because the
# failure is not recoverable once pushed.
#
# NOTE ON INSTALLATION. A global core.hooksPath (~/.git-hooks here) shadows
# .git/hooks entirely, so a hook placed there would never run. This repo sets
# core.hooksPath to .githooks locally instead:
#
#     git config core.hooksPath .githooks
#
# That local setting in turn shadows the global hooks, so this hook chains to
# the global pre-commit at the end and .githooks/pre-push delegates likewise.
#
# Deliberate exception:  git commit --no-verify

set -uo pipefail

fail=0
blocked=()

while IFS= read -r -d '' f; do
  case "$f" in
    *.docx|*.doc|*.xlsx|*.xls|*.pdf|*.odt|*.ods|*.rtf|*.pptx)
      blocked+=("$f  (document format -- never committed to the kit)")
      fail=1 ;;
    fixtures/*)
      blocked+=("$f  (fixtures/ is generated by tr-fixtures, not versioned)")
      fail=1 ;;
  esac

  # The entire kit is small text files. A large blob is a strong signal that
  # something that is not toolkit source is being committed.
  if [[ -f "$f" ]]; then
    sz=$(wc -c < "$f")
    if (( sz > 1048576 )); then
      blocked+=("$f  (${sz} bytes -- the kit is small text files only)")
      fail=1
    fi
  fi
done < <(git diff --cached --name-only -z --diff-filter=AM)

if (( fail )); then
  {
    echo
    echo "  BLOCKED: refusing to commit the following to the toolkit repo:"
    echo
    printf '    %s\n' "${blocked[@]}"
    echo
    echo "  Client material must never enter this repository. If the file is"
    echo "  genuinely part of the toolkit, commit it with:"
    echo
    echo "      git commit --no-verify"
    echo
  } >&2
  exit 1
fi

# Second gate: the documented tables must match lib/registry.py.
#
# The environment table said TR_PROMPT_VERSION defaulted to v1 while the code
# had said v4 for weeks, and six tools were documented nowhere at all. Both
# survived because a stale table looks exactly like a current one. The tables
# are now generated from the registry, so the only way they can disagree is
# if someone edited the registry and did not regenerate -- which is what this
# catches, at the point where it is still one command to fix.
#
# Uses the kit venv when it exists, because checking the .docx needs
# python-docx; falls back to the system interpreter, which checks the
# markdown and says it skipped the rest.
if [[ -x tools/gen-docs.py ]]; then
  py=python3
  [[ -x "$HOME/.translate-venv/bin/python" ]] && py="$HOME/.translate-venv/bin/python"
  if ! out="$("$py" tools/gen-docs.py 2>&1)"; then
    {
      echo
      echo "  BLOCKED: the documented tables have drifted from lib/registry.py"
      echo
      printf '%s\n' "$out" | sed 's/^/    /'
      echo
      echo "      tools/gen-docs.py --apply     then stage the result"
      echo
    } >&2
    exit 1
  fi
fi

# Chain to the workspace-wide gate, which this repo's local core.hooksPath
# would otherwise suppress.
globaldir=$(git config --global --get core.hooksPath || true)
if [[ -n "${globaldir:-}" && -x "$globaldir/pre-commit" ]]; then
  "$globaldir/pre-commit" "$@" || exit $?
fi

exit 0
